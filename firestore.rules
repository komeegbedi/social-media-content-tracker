rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function myDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    // A removed/disabled account is denied everywhere — even if it still carries
    // an 'admin' role on its tombstone. `disabled` is the authoritative kill switch.
    function notDisabled() {
      return myDoc().get('disabled', false) != true;
    }
    function isAdmin() {
      return hasProfile() && myDoc().role == 'admin' && notDisabled();
    }
    function isApproved() {
      return hasProfile() && notDisabled() && (myDoc().status == 'approved' || myDoc().role == 'admin');
    }
    // QA review authority is a SEPARATE axis from Admin. `qa == true` is the sole
    // grant — an Admin does NOT inherit review authority. A user who is both may
    // review because qa == true, not because they are an Admin. (Mirrors
    // canMakeReviewDecision in src/data.js.)
    function isQA() {
      return isApproved() && myDoc().get('qa', false) == true;
    }

    // ---- Parameterized profile predicates (hot path) ----
    // The task-UPDATE rule is the most complex in the ruleset. Calling myDoc()/
    // isAdmin()/isApproved()/isQA() repeatedly across its branches re-runs the
    // profile get() many times and blows the 1000-expression evaluation budget — so
    // an assertFails could pass on exhaustion instead of on the intended policy.
    // These `p*` helpers take the ALREADY-RESOLVED profile `p` (one get(), bound once
    // in the allow rule) and read only fields — no further document lookups. Same
    // semantics as isAdmin()/isApproved()/isQA(), just without the repeated get().
    function pDisabled(p)   { return p.get('disabled', false) == true; }
    function pIsAdmin(p)    { return p.role == 'admin' && !pDisabled(p); }
    function pIsApproved(p) { return !pDisabled(p) && (p.status == 'approved' || p.role == 'admin'); }
    function pIsQA(p)       { return pIsApproved(p) && p.get('qa', false) == true; }

    // ---- task workflow (the 7-stage state machine, mirrored from src/data.js) ----
    function taskStatuses() {
      return ['Planned', 'In Progress', 'In Review', 'Changes Requested',
              'Approved', 'Ready to Post', 'Posted'];
    }
    // The QA REVIEW DECISION: the two transitions that constitute normal content
    // review. These require qa == true and are NEVER granted by the Admin axis —
    // an Admin reaches Approved from In Review only through the audited override
    // callable (Admin SDK), producing an `admin_override` event, not a fake QA one.
    function isQaDecision(from, to) {
      return from == 'In Review' && (to == 'Approved' || to == 'Changes Requested');
    }
    // The newly-appended activity entry (only meaningful when the log grew by one).
    function grewByOne() {
      return request.resource.data.get('activity', []).size()
           == resource.data.get('activity', []).size() + 1;
    }
    // The last activity entry, or an empty map when the log is empty. Returning {}
    // (instead of indexing a[-1], which THROWS on an empty list) keeps every caller
    // throw-proof: their `.get(field, default)` reads simply fall back to defaults.
    function newEntry() {
      let a = request.resource.data.get('activity', []);
      return a.size() > 0 ? a[a.size() - 1] : {'uid': '', 'type': ''};
    }
    // A QA decision must be HARD-attributed AND correctly typed: the appended entry
    // carries the caller's own uid (no anonymous/impersonated review) and its event
    // type matches the destination — an approval is recorded as exactly 'approved',
    // a request-changes as 'changes_requested' (never mislabelled, e.g. as an override).
    // `grew`/`entry` are computed ONCE by the caller (pNormalUpdateOk) and passed in,
    // so the whole update decision evaluates grewByOne()/newEntry() a single time —
    // keeping the eagerly-evaluated expression tree small.
    function reviewDecisionAttributed(to, grew, entry) {
      return grew
        && entry.get('uid', '') == request.auth.uid
        && entry.get('type', '') == (to == 'Approved' ? 'approved' : 'changes_requested');
    }
    // The activity-event type that a PRODUCTION / POSTING transition MUST record, keyed
    // by destination status (mirrors eventType()/workflowAction().kind in src/data.js):
    //   → In Progress  : 'started'      → In Review    : 'qa_sent'
    //   → Ready to Post : 'ready'       → Posted       : 'posted'
    function productionEventType(to) {
      return to == 'In Progress' ? 'started'
           : to == 'In Review' ? 'qa_sent'
           : to == 'Ready to Post' ? 'ready'
           : to == 'Posted' ? 'posted'
           : '';
    }
    // A production/posting transition must be HARD-attributed AND correctly typed: the
    // appended entry carries the caller's own uid and its event type is EXACTLY the one
    // this destination requires — a missing, wrong, or forged type is denied (e.g. a
    // Planned→In Progress that records 'approved', or a Ready to Post→Posted that
    // records 'ready'). Combined with reviewDecisionAttributed (QA) this fixes the
    // type to the transition for every stage.
    function productionTransitionAttributed(to, grew, entry) {
      return grew
        && entry.get('uid', '') == request.auth.uid
        && entry.get('type', '') == productionEventType(to);
    }
    // EVERY task write's audit-log append must be attributed to the caller (no forging
    // another actor) AND must NOT be a client-authored admin_override (that event is
    // produced ONLY by the server-side override callable). Combines the former
    // activityAttributionOk + noClientOverrideEntry into one pass over `grew`/`entry`.
    function auditAppendOk(grew, entry) {
      return !grew
        || (entry.get('uid', request.auth.uid) == request.auth.uid
            && entry.get('type', '') != 'admin_override');
    }
    // ---- Stable assignment identity (UID-based authorization) ----
    // A task's AUTHORITATIVE assignee uid set, read from the BEFORE state so a caller
    // can never authorize themselves with the same write. Legacy tasks (not yet
    // backfilled) have no `assigneeUids` — for those ONLY, fall back to an owner-NAME
    // match (transitional; removed once backfill coverage is validated). Crew get
    // production access exclusively via uids, so a stale name can't grant it.
    function pIsTaskAssignee(p) {
      // The legacy owner-NAME fallback applies ONLY when the assigneeUids FIELD is
      // genuinely ABSENT (un-backfilled task). A PRESENT field — even an empty [] or a
      // partial set — is UID-AUTHORITATIVE: only its stored uids authorize, and an
      // intentionally-empty/unresolved assignment never reverts to name authorization.
      return ('assigneeUids' in resource.data)
        ? (request.auth.uid in resource.data.assigneeUids)
        : (resource.data.get('owner', ' ') == p.get('name', ''));
    }
    // Any APPROVED, non-QA assignee (owner OR crew, any production role) — or an Admin
    // — may advance PRODUCTION. NOT a QA or captions grant. Admin is included so
    // admins drive the normal forward workflow WITHOUT an admin_override event
    // (Admin+QA operates production via Admin). The pIsApproved guard denies
    // pending/removed/disabled assignees; the `qa != true` guard denies a QA-only
    // reviewer even if their uid was placed in assigneeUids — QA observes, never
    // produces. This predicate also gates production DATA (links/blockers) edits.
    function pCanAdvanceProduction(p) {
      return pIsAdmin(p) || (pIsApproved(p) && p.get('qa', false) != true && pIsTaskAssignee(p));
    }
    // Captions/posting authority — or Admin. Separate from production + QA.
    function pCanPost(p) { return pIsAdmin(p) || p.get('captions', false) == true; }
    // A stored content link must be a real http(s) URL — never blank, whitespace,
    // plain text, or a scheme-less string. Mirrors isValidUrl() in src/data.js:
    // an http/https scheme, no whitespace, and a dotted host. (?i) makes the scheme
    // case-insensitive; the leading host label excludes '/' so a dotted host is required.
    function pValidLink(links, key) {
      let v = links.get(key, '');
      return v is string && v.matches('(?i)^https?://[^\\s/]+[.][^\\s]+$');
    }
    // The content type's REQUIRED deliverable link(s) are all present AND valid —
    // validated at the security boundary, not only in React (mirrors requiredLinkKeys()
    // + missingLinks() in src/data.js).
    function pRequiredLinksPresent() {
      let type = request.resource.data.get('type', '');
      let links = request.resource.data.get('links', {});
      return type == 'Poster' ? (pValidLink(links, 'ig') && pValidLink(links, 'landscape'))
           : type == 'Reel' ? pValidLink(links, 'video')
           : type == 'Photography' ? pValidLink(links, 'photos')
           : true;
    }
    // Statuses at which the required links MUST be present + valid ("submitted to QA
    // or beyond"). "Changes Requested" is a rework state and is excluded, so QA can
    // still bounce a link-less item back. Mirrors statusRequiresLinks() in src/data.js.
    function pStatusRequiresLinks(s) {
      return s == 'In Review' || s == 'Approved' || s == 'Ready to Post' || s == 'Posted';
    }
    // Is a proposed `from -> to` status change legal for THIS actor via a DIRECT
    // client write?
    //   assignee     : Planned→In Progress, In Progress→In Review, Changes Requested→In Review
    //                  (any owner/crew production role; →In Review also needs the links)
    //   QA (qa==true): In Review→Approved | Changes Requested   (the QA decision, attributed)
    //   captions     : Approved→Ready to Post, Ready to Post→Posted
    // An Admin drives the same NORMAL FORWARD steps as an owner-/caption-substitute
    // (mirrors src/data.js workflowAction) — but this grants NO shortcut to the QA
    // decision and NO arbitrary, backward, or lifecycle-bypassing jump. Therefore:
    //   • the ONLY direct path into Approved / Changes Requested is In Review by a
    //     qa===true actor with authenticated attribution (an Admin-only user can
    //     never reach them directly, from any status);
    //   • Ready to Post / Posted are reachable only from their immediate predecessor
    //     (no Planned→Posted style bypass);
    //   • every OTHER exceptional correction (backward moves, bypass jumps, an Admin
    //     forcing a QA-decision status) MUST go through the server-authored, audited
    //     adminOverrideStatus callable, which records an admin_override event.
    // A no-op (from == to) is always allowed so members/admins can edit other fields.
    // Takes the resolved profile `p` (no get() inside) — same policy as before.
    function pTransitionAllowed(p, from, to, grew, entry) {
      // Encode the step as "from>to" and test SET membership — one `in` check per
      // role instead of a fan-out of paired comparisons, which keeps the eagerly-
      // evaluated expression tree well under the emulator's budget.
      // The type's required links are enforced separately (pNormalUpdateOk, for ANY
      // transition INTO a link-gated stage), so this predicate is purely about which
      // actor may make which step — no link check duplicated here.
      let step = from + '>' + to;
      let toReview = step == 'In Progress>In Review' || step == 'Changes Requested>In Review';
      return from == to
        || (pIsQA(p) && isQaDecision(from, to) && reviewDecisionAttributed(to, grew, entry))
        || (pCanAdvanceProduction(p) && productionTransitionAttributed(to, grew, entry) && (
              step == 'Planned>In Progress' || toReview))
        || (pCanPost(p) && productionTransitionAttributed(to, grew, entry)
              && step in ['Approved>Ready to Post', 'Ready to Post>Posted']);
    }
    // Attribution integrity for EVERY task write: when the audit log grows, the new
    // entry's uid (when the client supplies one) must be the caller — no forging
    // another actor into the history. Backward-compatible with older entries that
    // carry no uid (they default to the caller and pass).
    // Integrity checks applied to EVERY task write (members AND admins):
    //  • status is a real status value;
    //  • the audit log is append-only — it can only grow, by at most one entry
    //    per write (no truncation, no wholesale forgery of history);
    //  • archivedAt only appears on a Posted task, and a non-admin can never
    //    clear one that's already set (no un-archiving to hide history).
    function pTaskIntegrityOk(p) {
      let oldAct = resource.data.get('activity', []);
      let newAct = request.resource.data.get('activity', []);
      let oldArch = resource.data.get('archivedAt', null);
      let newArch = request.resource.data.get('archivedAt', null);
      return request.resource.data.status in taskStatuses()
        && newAct is list
        && newAct.size() >= oldAct.size()
        && newAct.size() <= oldAct.size() + 1
        && (newArch == null || request.resource.data.status == 'Posted')
        && (pIsAdmin(p) || oldArch == null || newArch != null);
    }

    // ---- Trash (soft-delete) invariants ----
    // A task is trashed iff it carries a deletedAt marker. The status field is NEVER
    // repurposed for deletion, so restore returns the exact prior workflow state.
    function isTrashed(d) { return d.get('deletedAt', null) != null; }
    // The ONLY keys the trash/restore transitions may touch.
    function trashKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['deletedAt', 'deletedBy', 'deletedByName', 'updatedAt']);
    }
    // active → trashed: an active admin, deletedAt == request.time, deletedBy == the
    // caller, deletedByName is REQUIRED and must equal the caller's profile name (no
    // rule-supplied default — a missing name is denied), and ONLY the marker keys
    // change — so status and every business field stay exactly as they were.
    // Every optional field is read via .get()/`in` so a MISSING marker yields an
    // ordinary false (an explicit denial), never a "Property X is undefined"
    // evaluation error. deletedByName is still REQUIRED (missing -> denied).
    function pTrashTransitionOk(p) {
      return pIsAdmin(p)
        && trashKeysOnly()
        && request.resource.data.get('deletedAt', null) == request.time
        && request.resource.data.get('deletedBy', '') == request.auth.uid
        && ('deletedByName' in request.resource.data)
        && request.resource.data.get('deletedByName', '') == p.name
        && request.resource.data.status == resource.data.status;
    }
    // trashed → active (restore): an active admin removes ALL markers together and
    // changes nothing else. Partial clearing (leaving deletedBy/deletedByName) is denied.
    function pRestoreTransitionOk(p) {
      return pIsAdmin(p)
        && trashKeysOnly()
        && !('deletedAt' in request.resource.data)
        && !('deletedBy' in request.resource.data)
        && !('deletedByName' in request.resource.data)
        && request.resource.data.status == resource.data.status;
    }
    // A NORMAL (active → active) update: base integrity + attribution + no forged
    // override, a role-legal status transition, and — for non-admins — only the
    // collaboration allowlist. The status transition is evaluated ONCE and shared.
    // A non-admin member's field set. ASSIGNMENT IDENTITY (owner/ownerUid/support/
    // assigneeUids/ownerSuggested) is deliberately NOT in this allowlist, so a member
    // can never grant themselves access — and PRODUCTION DATA (links, blockedOn) may
    // change only when the caller is an assignee. Reactions + comments stay open so
    // any member can still react/comment/mention.
    function pMemberFieldsOk(p) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return pIsApproved(p)
        && changed.hasOnly(['status', 'comments', 'reactions', 'updatedAt', 'archivedAt',
                            'blockedOn', 'links', 'activity', 'caption', 'postLink'])
        // Production DATA (links, blockers) → production operators only (assignee,
        // non-QA, approved) or Admin — same authority as advancing production.
        && (!changed.hasAny(['links', 'blockedOn']) || pCanAdvanceProduction(p))
        // Caption / final post-link → captions-authorized or Admin (posting axis).
        && (!changed.hasAny(['caption', 'postLink']) || pCanPost(p));
    }
    // A REAL status transition must append EXACTLY ONE activity entry (grewByOne),
    // and a STATUS-PRESERVING edit must NOT modify or append activity at all. Combined
    // with auditAppendOk (attribution) + taskIntegrityOk (append-only, ≤ +1) this makes
    // every transition carry exactly one correctly-attributed event and blocks a
    // same-status write from injecting or rewriting workflow history.
    function pActivityConsistent(grew) {
      return resource.data.status != request.resource.data.status
        ? grew
        : request.resource.data.get('activity', []) == resource.data.get('activity', []);
    }
    function pNormalUpdateOk(p) {
      // Compute the audit-append facts ONCE and thread them through both the
      // attribution check and the QA-decision check — a single grewByOne()/newEntry()
      // evaluation for the whole decision (keeps the eager expression tree small).
      let grew = grewByOne();
      let entry = newEntry();
      return pTaskIntegrityOk(p)
        && pActivityConsistent(grew)
        && auditAppendOk(grew, entry)
        && pTransitionAllowed(p, resource.data.status, request.resource.data.status, grew, entry)
        // Any TRANSITION into a link-gated stage (submit / resubmit / QA approve /
        // ready / posted) requires the type's valid links. A same-status edit is left
        // to its existing policy, so reactions/comments on a legacy record aren't newly
        // blocked; a stale/modified client still can't advance a link-less item.
        && (resource.data.status == request.resource.data.status
            || !pStatusRequiresLinks(request.resource.data.status)
            || pRequiredLinksPresent())
        && (pIsAdmin(p) || pMemberFieldsOk(p));
    }
    // THE task-update decision, structured around mutually-exclusive Trash-state
    // transitions so exactly ONE branch's predicate evaluates (the others fail their
    // cheap state guard and short-circuit — no wasted profile lookups, no evaluator
    // exhaustion). `p` is the caller's profile, resolved ONCE by the allow rule.
    //   active  → trashed : Trash transition
    //   trashed → active  : Restore transition
    //   active  → active  : normal update
    //   trashed → trashed : (no matching branch) → DENIED
    function taskUpdateDecision(p) {
      let wasTrashed = isTrashed(resource.data);
      let nowTrashed = isTrashed(request.resource.data);
      return (!wasTrashed && nowTrashed  && pTrashTransitionOk(p))
          || (wasTrashed  && !nowTrashed && pRestoreTransitionOk(p))
          || (!wasTrashed && !nowTrashed && pNormalUpdateOk(p));
    }

    match /users/{uid} {
      // Read your own profile always; read others only once you're approved.
      allow get: if signedIn() && (request.auth.uid == uid || isApproved());
      allow list: if isApproved();

      // On registration you may create ONLY your own doc, and only as a
      // pending member — you cannot make yourself an admin or pre-approved,
      // nor grant yourself the QA / captions roles. Privileges are admin-only.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'pending'
        && request.resource.data.get('qa', false) == false
        && request.resource.data.get('captions', false) == false
        && request.resource.data.get('lead', false) == false;

      // A QA reviewer is a distinct, non-production department: they must never
      // carry production skills (that's what makes them staffable/recommended).
      // Enforce the invariant server-side so no client — even a buggy admin
      // form — can persist a QA user with skills.
      function qaInvariantOk(d) {
        return d.get('qa', false) == false || d.get('skills', []).size() == 0;
      }
      // Admins edit profiles (approvals, roles, skills, flags, removal), subject
      // to the QA invariant. Members may self-edit ONLY their notification
      // preferences and appearance — nothing else (changing their own
      // skills/flags could game auto-assignment).
      allow update: if (isAdmin() && qaInvariantOk(request.resource.data))
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifPrefs', 'appearance']));
      allow delete: if isAdmin();

      // Web-push device tokens: a user manages only their own.
      match /fcmTokens/{token} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // In-app notifications. Written server-side (Admin SDK bypasses rules);
    // a user may read only their own and mark them read — nothing else.
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // Materialized reminder queue — entirely server-owned. Admins may read it
    // for the delivery log; no client ever writes it.
    match /reminderInstances/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Durable per-user-per-day reminder email digest — server-owned. Admins read
    // it for the delivery log; no client ever writes it.
    match /reminderDigests/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin operations saga state (e.g. user removal) — server-owned. Admins read
    // for progress/status; no client ever writes it.
    match /adminOps/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Immutable administrative audit log — server-authored only. Admins read it;
    // NO client may ever create, edit, or delete an audit event (not even admins).
    match /auditEvents/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Email delivery ledger (Resend) — written server-side only; admins read
    // it for the delivery log. Never client-writable.
    match /emailDeliveries/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Email usage counters (monthly/daily quota). Server-managed; admins read
    // for the usage dashboard. Never client-writable — the hard limit can't be
    // altered from the frontend.
    match /systemUsage/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin-managed recurring event series: everyone approved can read the
    // active series (Home renders occurrences); only admins create/edit.
    match /eventSeries/{id} {
      allow read: if isApproved();
      // Admins create + edit series (archive/unarchive is an `archived` flag update).
      // HARD DELETE IS DENIED for every client: a recurring series is retired by
      // ARCHIVING it (reversible), never erased — so linked history/occurrences and
      // the restore path are never lost to a stray client delete.
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // App-wide settings (e.g. default reminder schedule, leadership roles).
    match /settings/{docId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    match /tasks/{taskId} {
      // READ-ACCESS POLICY — Option A: Trash is NOT confidential.
      // This is a shared internal board: every approved member already reads every
      // task, and a trashed task is the same content that was visible moments ago —
      // there is no data-sensitivity reason to hide it at the data layer. So members
      // retain read access to trashed tasks; the app hides Trash OPERATIONALLY (the
      // shared activeTasks boundary + a non-admin "unavailable" dead-end). That
      // dead-end is a UX affordance, NOT a security boundary — it is deliberately not
      // described to users as "unauthorized". Admin-only confidentiality (Option B)
      // would need an explicit queryable `trashed` field + a migration of every
      // existing task; it is intentionally NOT adopted here.
      allow read: if isApproved();

      // Admins create tasks. A task can never be BORN trashed — client-supplied
      // Trash metadata is rejected at creation. Nor can it be BORN (or imported)
      // directly into a link-gated stage (In Review / Approved / Ready to Post /
      // Posted) without the type's valid required links — same invariant as updates.
      allow create: if isAdmin()
        && request.resource.data.get('deletedAt', null) == null
        && !('deletedBy' in request.resource.data)
        && !('deletedByName' in request.resource.data)
        && (!pStatusRequiresLinks(request.resource.data.get('status', 'Planned'))
            || pRequiredLinksPresent());
      // HARD DELETE IS DENIED for everyone, including admins. Removal is a reversible
      // soft-delete (the Trash transition below); permanent deletion is out of scope
      // and has no client path — so a stale/compromised client can never erase content.
      allow delete: if false;

      // Updates are decided by taskUpdateDecision(), structured around mutually-
      // exclusive Trash-state transitions (active->trashed, trashed->active,
      // active->active); trashed->trashed has no matching branch and is denied. The
      // caller's profile is resolved ONCE here and threaded in, so the whole decision
      // stays well under the evaluator's expression budget — no assertFails can pass
      // by exhaustion instead of by an explicit false policy result.
      allow update: if signedIn() && hasProfile() && taskUpdateDecision(myDoc());

      // Comments as a subcollection (v1.1) — the canonical comment store. Approved
      // members read all and may post their OWN (uid must match the caller;
      // display name is trusted only for rendering). Strict schema + size limits;
      // edits/removal are admin-only. Feeds the server-side @mention trigger.
      match /comments/{commentId} {
        // The parent task must EXIST and be ACTIVE for any comment WRITE. While a task
        // is in Trash (or missing), ALL comment collaboration stops — creation AND
        // admin moderation (edit/delete) — so Trash freezes the whole thread;
        // moderation resumes on Restore. Reads are unaffected. The exists() guard
        // means a missing parent returns an ordinary `false`, never a `null.data`
        // evaluation error.
        function parentTaskActive() {
          return exists(/databases/$(database)/documents/tasks/$(taskId))
            && get(/databases/$(database)/documents/tasks/$(taskId)).data.get('deletedAt', null) == null;
        }
        allow read: if isApproved();
        allow create: if isApproved()
          && parentTaskActive()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'who', 'txt', 'tm', 'mentions', 'mentionNames', 'mentionAll'])
          && request.resource.data.txt is string
          && request.resource.data.txt.size() > 0
          && request.resource.data.txt.size() <= 2000
          && request.resource.data.tm == request.time
          // Individual mentions: uids the trigger re-validates + notifies (≤ 20).
          && request.resource.data.get('mentions', []) is list
          && request.resource.data.get('mentions', []).size() <= 20
          // mentionNames: the exact selected display strings (render + rename-resilience),
          // aligned to `mentions`. Client-only rendering aid — the server never trusts it
          // for identity — so it is bounded but not otherwise constrained.
          && request.resource.data.get('mentionNames', []) is list
          && request.resource.data.get('mentionNames', []).size() <= 20
          // mentionAll: the @all/@everyone group token. The TRIGGER derives recipients
          // from the task's assigneeUids — a client-supplied uid list is never expanded.
          && request.resource.data.get('mentionAll', false) is bool;
        allow update, delete: if isAdmin() && parentTaskActive();
      }
    }

    // Issue log: user-filed reports/feature-requests and auto-captured runtime
    // errors. Strict schema (no arbitrary fields), size-bounded, server-stamped,
    // and only under your own uid. Auto-captured ERRORS may come from any signed-in
    // user (they happen during setup, before approval); user-INITIATED reports and
    // feature requests require an approved account.
    match /issues/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'uid', 'kind', 'message', 'stack', 'action', 'code', 'taskId', 'note',
             'status', 'route', 'online', 'userAgent', 'viewport', 'url', 'email',
             'title', 'problem', 'beneficiary', 'link', 'createdAt'])
        && request.resource.data.kind in ['error', 'report', 'feature_request']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('message', '').size() <= 4000
        && request.resource.data.get('stack', '').size() <= 8000
        && request.resource.data.get('note', '').size() <= 4000
        && request.resource.data.get('problem', '').size() <= 4000
        && (request.resource.data.kind == 'error' || isApproved());
      // Only admins can read the log, triage (resolve), or delete.
      allow read, update, delete: if isAdmin();
    }
  }
}
