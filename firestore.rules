rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function myDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    // A removed/disabled account is denied everywhere — even if it still carries
    // an 'admin' role on its tombstone. `disabled` is the authoritative kill switch.
    function notDisabled() {
      return myDoc().get('disabled', false) != true;
    }
    function isAdmin() {
      return hasProfile() && myDoc().role == 'admin' && notDisabled();
    }
    function isApproved() {
      return hasProfile() && notDisabled() && (myDoc().status == 'approved' || myDoc().role == 'admin');
    }
    // QA review authority is a SEPARATE axis from Admin. `qa == true` is the sole
    // grant — an Admin does NOT inherit review authority. A user who is both may
    // review because qa == true, not because they are an Admin. (Mirrors
    // canMakeReviewDecision in src/data.js.)
    function isQA() {
      return isApproved() && myDoc().get('qa', false) == true;
    }

    // ---- Parameterized profile predicates (hot path) ----
    // The task-UPDATE rule is the most complex in the ruleset. Calling myDoc()/
    // isAdmin()/isApproved()/isQA() repeatedly across its branches re-runs the
    // profile get() many times and blows the 1000-expression evaluation budget — so
    // an assertFails could pass on exhaustion instead of on the intended policy.
    // These `p*` helpers take the ALREADY-RESOLVED profile `p` (one get(), bound once
    // in the allow rule) and read only fields — no further document lookups. Same
    // semantics as isAdmin()/isApproved()/isQA(), just without the repeated get().
    function pDisabled(p)   { return p.get('disabled', false) == true; }
    function pIsAdmin(p)    { return p.role == 'admin' && !pDisabled(p); }
    function pIsApproved(p) { return !pDisabled(p) && (p.status == 'approved' || p.role == 'admin'); }
    function pIsQA(p)       { return pIsApproved(p) && p.get('qa', false) == true; }

    // ---- task workflow (the 7-stage state machine, mirrored from src/data.js) ----
    function taskStatuses() {
      return ['Planned', 'In Progress', 'In Review', 'Changes Requested',
              'Approved', 'Ready to Post', 'Posted'];
    }
    // The QA REVIEW DECISION: the two transitions that constitute normal content
    // review. These require qa == true and are NEVER granted by the Admin axis —
    // an Admin reaches Approved from In Review only through the audited override
    // callable (Admin SDK), producing an `admin_override` event, not a fake QA one.
    function isQaDecision(from, to) {
      return from == 'In Review' && (to == 'Approved' || to == 'Changes Requested');
    }
    // The newly-appended activity entry (only meaningful when the log grew by one).
    function grewByOne() {
      return request.resource.data.get('activity', []).size()
           == resource.data.get('activity', []).size() + 1;
    }
    // The last activity entry, or an empty map when the log is empty. Returning {}
    // (instead of indexing a[-1], which THROWS on an empty list) keeps every caller
    // throw-proof: their `.get(field, default)` reads simply fall back to defaults.
    function newEntry() {
      let a = request.resource.data.get('activity', []);
      return a.size() > 0 ? a[a.size() - 1] : {'uid': '', 'type': ''};
    }
    // A QA decision must be HARD-attributed AND correctly typed: the appended entry
    // carries the caller's own uid (no anonymous/impersonated review) and its event
    // type matches the destination — an approval is recorded as exactly 'approved',
    // a request-changes as 'changes_requested' (never mislabelled, e.g. as an override).
    // `grew`/`entry` are computed ONCE by the caller (pNormalUpdateOk) and passed in,
    // so the whole update decision evaluates grewByOne()/newEntry() a single time —
    // keeping the eagerly-evaluated expression tree small.
    function reviewDecisionAttributed(to, grew, entry) {
      return grew
        && entry.get('uid', '') == request.auth.uid
        && entry.get('type', '') == (to == 'Approved' ? 'approved' : 'changes_requested');
    }
    // The activity-event type that a PRODUCTION / POSTING transition MUST record, keyed
    // by destination status (mirrors eventType()/workflowAction().kind in src/data.js):
    //   → In Progress  : 'started'      → In Review    : 'qa_sent'
    //   → Ready to Post : 'ready'       → Posted       : 'posted'
    function productionEventType(to) {
      return to == 'In Progress' ? 'started'
           : to == 'In Review' ? 'qa_sent'
           : to == 'Ready to Post' ? 'ready'
           : to == 'Posted' ? 'posted'
           : '';
    }
    // A production/posting transition must be HARD-attributed AND correctly typed: the
    // appended entry carries the caller's own uid and its event type is EXACTLY the one
    // this destination requires — a missing, wrong, or forged type is denied (e.g. a
    // Planned→In Progress that records 'approved', or a Ready to Post→Posted that
    // records 'ready'). Combined with reviewDecisionAttributed (QA) this fixes the
    // type to the transition for every stage.
    function productionTransitionAttributed(to, grew, entry) {
      return grew
        && entry.get('uid', '') == request.auth.uid
        && entry.get('type', '') == productionEventType(to);
    }
    // EVERY task write's audit-log append must be attributed to the caller (no forging
    // another actor) AND must NOT be a client-authored admin_override (that event is
    // produced ONLY by the server-side override callable). Combines the former
    // activityAttributionOk + noClientOverrideEntry into one pass over `grew`/`entry`.
    function auditAppendOk(grew, entry) {
      return !grew
        || (entry.get('uid', request.auth.uid) == request.auth.uid
            && entry.get('type', '') != 'admin_override');
    }
    // ---- Stable assignment identity (UID-based authorization) ----
    // A task's AUTHORITATIVE assignee uid set, read from the BEFORE state so a caller
    // can never authorize themselves with the same write. Legacy tasks (not yet
    // backfilled) have no `assigneeUids` — for those ONLY, fall back to an owner-NAME
    // match (transitional; removed once backfill coverage is validated). Crew get
    // production access exclusively via uids, so a stale name can't grant it.
    function pIsTaskAssignee(p) {
      // The legacy owner-NAME fallback applies ONLY when the assigneeUids FIELD is
      // genuinely ABSENT (un-backfilled task). A PRESENT field — even an empty [] or a
      // partial set — is UID-AUTHORITATIVE: only its stored uids authorize, and an
      // intentionally-empty/unresolved assignment never reverts to name authorization.
      return ('assigneeUids' in resource.data)
        ? (request.auth.uid in resource.data.assigneeUids)
        : (resource.data.get('owner', ' ') == p.get('name', ''));
    }
    // Any APPROVED, non-QA assignee (owner OR crew, any production role) — or an Admin
    // — may advance PRODUCTION. NOT a QA or captions grant. Admin is included so
    // admins drive the normal forward workflow WITHOUT an admin_override event
    // (Admin+QA operates production via Admin). The pIsApproved guard denies
    // pending/removed/disabled assignees; the `qa != true` guard denies a QA-only
    // reviewer even if their uid was placed in assigneeUids — QA observes, never
    // produces. This predicate also gates production DATA (links/blockers) edits.
    function pCanAdvanceProduction(p) {
      return pIsAdmin(p) || (pIsApproved(p) && p.get('qa', false) != true && pIsTaskAssignee(p));
    }
    // Captions/posting authority — or Admin. Separate from production + QA.
    function pCanPost(p) { return pIsAdmin(p) || p.get('captions', false) == true; }
    // A stored content link must be a real http(s) URL — never blank, whitespace,
    // plain text, or a scheme-less string. Mirrors isValidUrl() in src/data.js:
    // an http/https scheme, no whitespace, and a dotted host. (?i) makes the scheme
    // case-insensitive; the leading host label excludes '/' so a dotted host is required.
    function pValidLink(links, key) {
      let v = links.get(key, '');
      return v is string && v.matches('(?i)^https?://[^\\s/]+[.][^\\s]+$');
    }
    // The content type's REQUIRED deliverable link(s) are all present AND valid —
    // validated at the security boundary, not only in React (mirrors requiredLinkKeys()
    // + missingLinks() in src/data.js).
    function pRequiredLinksPresent() {
      let type = request.resource.data.get('type', '');
      let links = request.resource.data.get('links', {});
      return type == 'Poster' ? (pValidLink(links, 'ig') && pValidLink(links, 'landscape'))
           : type == 'Reel' ? pValidLink(links, 'video')
           : type == 'Photography' ? pValidLink(links, 'photos')
           : true;
    }
    // Statuses at which the required links MUST be present + valid ("submitted to QA
    // or beyond"). "Changes Requested" is a rework state and is excluded, so QA can
    // still bounce a link-less item back. Mirrors statusRequiresLinks() in src/data.js.
    function pStatusRequiresLinks(s) {
      return s == 'In Review' || s == 'Approved' || s == 'Ready to Post' || s == 'Posted';
    }
    // Is a proposed `from -> to` status change legal for THIS actor via a DIRECT
    // client write?
    //   assignee     : Planned→In Progress, In Progress→In Review, Changes Requested→In Review
    //                  (any owner/crew production role; →In Review also needs the links)
    //   QA (qa==true): In Review→Approved | Changes Requested   (the QA decision, attributed)
    //   captions     : Approved→Ready to Post, Ready to Post→Posted
    // An Admin drives the same NORMAL FORWARD steps as an owner-/caption-substitute
    // (mirrors src/data.js workflowAction) — but this grants NO shortcut to the QA
    // decision and NO arbitrary, backward, or lifecycle-bypassing jump. Therefore:
    //   • the ONLY direct path into Approved / Changes Requested is In Review by a
    //     qa===true actor with authenticated attribution (an Admin-only user can
    //     never reach them directly, from any status);
    //   • Ready to Post / Posted are reachable only from their immediate predecessor
    //     (no Planned→Posted style bypass);
    //   • every OTHER exceptional correction (backward moves, bypass jumps, an Admin
    //     forcing a QA-decision status) MUST go through the server-authored, audited
    //     adminOverrideStatus callable, which records an admin_override event.
    // A no-op (from == to) is always allowed so members/admins can edit other fields.
    // Takes the resolved profile `p` (no get() inside) — same policy as before.
    function pTransitionAllowed(p, from, to, grew, entry) {
      // Encode the step as "from>to" and test SET membership — one `in` check per
      // role instead of a fan-out of paired comparisons, which keeps the eagerly-
      // evaluated expression tree well under the emulator's budget.
      // The type's required links are enforced separately (pNormalUpdateOk, for ANY
      // transition INTO a link-gated stage), so this predicate is purely about which
      // actor may make which step — no link check duplicated here.
      let step = from + '>' + to;
      let toReview = step == 'In Progress>In Review' || step == 'Changes Requested>In Review';
      return from == to
        || (pIsQA(p) && isQaDecision(from, to) && reviewDecisionAttributed(to, grew, entry))
        || (pCanAdvanceProduction(p) && productionTransitionAttributed(to, grew, entry) && (
              step == 'Planned>In Progress' || toReview))
        || (pCanPost(p) && productionTransitionAttributed(to, grew, entry)
              && step in ['Approved>Ready to Post', 'Ready to Post>Posted']);
    }
    // Attribution integrity for EVERY task write: when the audit log grows, the new
    // entry's uid (when the client supplies one) must be the caller — no forging
    // another actor into the history. Backward-compatible with older entries that
    // carry no uid (they default to the caller and pass).
    // Integrity checks applied to EVERY task write (members AND admins):
    //  • status is a real status value;
    //  • the audit log is append-only — it can only grow, by at most one entry
    //    per write (no truncation, no wholesale forgery of history);
    //  • archivedAt only appears on a Posted task, and a non-admin can never
    //    clear one that's already set (no un-archiving to hide history).
    function pTaskIntegrityOk(p) {
      let oldAct = resource.data.get('activity', []);
      let newAct = request.resource.data.get('activity', []);
      let oldArch = resource.data.get('archivedAt', null);
      let newArch = request.resource.data.get('archivedAt', null);
      return request.resource.data.status in taskStatuses()
        && newAct is list
        && newAct.size() >= oldAct.size()
        && newAct.size() <= oldAct.size() + 1
        && (newArch == null || request.resource.data.status == 'Posted')
        && (pIsAdmin(p) || oldArch == null || newArch != null);
    }

    // ---- Trash (soft-delete) invariants ----
    // A task is trashed iff it carries a deletedAt marker. The status field is NEVER
    // repurposed for deletion, so restore returns the exact prior workflow state.
    function isTrashed(d) { return d.get('deletedAt', null) != null; }
    // The ONLY keys the trash/restore transitions may touch.
    function trashKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['deletedAt', 'deletedBy', 'deletedByName', 'updatedAt']);
    }
    // active → trashed: an active admin, deletedAt == request.time, deletedBy == the
    // caller, deletedByName is REQUIRED and must equal the caller's profile name (no
    // rule-supplied default — a missing name is denied), and ONLY the marker keys
    // change — so status and every business field stay exactly as they were.
    // Every optional field is read via .get()/`in` so a MISSING marker yields an
    // ordinary false (an explicit denial), never a "Property X is undefined"
    // evaluation error. deletedByName is still REQUIRED (missing -> denied).
    function pTrashTransitionOk(p) {
      return pIsAdmin(p)
        && trashKeysOnly()
        && request.resource.data.get('deletedAt', null) == request.time
        && request.resource.data.get('deletedBy', '') == request.auth.uid
        && ('deletedByName' in request.resource.data)
        && request.resource.data.get('deletedByName', '') == p.name
        && request.resource.data.status == resource.data.status;
    }
    // trashed → active (restore): an active admin removes ALL markers together and
    // changes nothing else. Partial clearing (leaving deletedBy/deletedByName) is denied.
    function pRestoreTransitionOk(p) {
      return pIsAdmin(p)
        && trashKeysOnly()
        && !('deletedAt' in request.resource.data)
        && !('deletedBy' in request.resource.data)
        && !('deletedByName' in request.resource.data)
        && request.resource.data.status == resource.data.status;
    }
    // A NORMAL (active → active) update: base integrity + attribution + no forged
    // override, a role-legal status transition, and — for non-admins — only the
    // collaboration allowlist. The status transition is evaluated ONCE and shared.
    // A non-admin member's field set. ASSIGNMENT IDENTITY (owner/ownerUid/support/
    // assigneeUids/ownerSuggested) is deliberately NOT in this allowlist, so a member
    // can never grant themselves access — and PRODUCTION DATA (links, blockedOn) may
    // change only when the caller is an assignee. Reactions + comments stay open so
    // any member can still react/comment/mention.
    function pMemberFieldsOk(p) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return pIsApproved(p)
        && changed.hasOnly(['status', 'comments', 'reactions', 'updatedAt', 'archivedAt',
                            'blockedOn', 'links', 'activity', 'caption', 'postLink'])
        // Production DATA (links, blockers) → production operators only (assignee,
        // non-QA, approved) or Admin — same authority as advancing production.
        && (!changed.hasAny(['links', 'blockedOn']) || pCanAdvanceProduction(p))
        // Caption / final post-link → captions-authorized or Admin (posting axis).
        && (!changed.hasAny(['caption', 'postLink']) || pCanPost(p));
    }
    // A REAL status transition must append EXACTLY ONE activity entry (grewByOne),
    // and a STATUS-PRESERVING edit must NOT modify or append activity at all. Combined
    // with auditAppendOk (attribution) + taskIntegrityOk (append-only, ≤ +1) this makes
    // every transition carry exactly one correctly-attributed event and blocks a
    // same-status write from injecting or rewriting workflow history.
    function pActivityConsistent(grew) {
      return resource.data.status != request.resource.data.status
        ? grew
        : request.resource.data.get('activity', []) == resource.data.get('activity', []);
    }
    function pNormalUpdateOk(p) {
      // Compute the audit-append facts ONCE and thread them through both the
      // attribution check and the QA-decision check — a single grewByOne()/newEntry()
      // evaluation for the whole decision (keeps the eager expression tree small).
      let grew = grewByOne();
      let entry = newEntry();
      return pTaskIntegrityOk(p)
        && pActivityConsistent(grew)
        && auditAppendOk(grew, entry)
        && pTransitionAllowed(p, resource.data.status, request.resource.data.status, grew, entry)
        // Any TRANSITION into a link-gated stage (submit / resubmit / QA approve /
        // ready / posted) requires the type's valid links. A same-status edit is left
        // to its existing policy, so reactions/comments on a legacy record aren't newly
        // blocked; a stale/modified client still can't advance a link-less item.
        && (resource.data.status == request.resource.data.status
            || !pStatusRequiresLinks(request.resource.data.status)
            || pRequiredLinksPresent())
        && (pIsAdmin(p) || pMemberFieldsOk(p));
    }
    // THE task-update decision, structured around mutually-exclusive Trash-state
    // transitions so exactly ONE branch's predicate evaluates (the others fail their
    // cheap state guard and short-circuit — no wasted profile lookups, no evaluator
    // exhaustion). `p` is the caller's profile, resolved ONCE by the allow rule.
    //   active  → trashed : Trash transition
    //   trashed → active  : Restore transition
    //   active  → active  : normal update
    //   trashed → trashed : (no matching branch) → DENIED
    function taskUpdateDecision(p) {
      let wasTrashed = isTrashed(resource.data);
      let nowTrashed = isTrashed(request.resource.data);
      return (!wasTrashed && nowTrashed  && pTrashTransitionOk(p))
          || (wasTrashed  && !nowTrashed && pRestoreTransitionOk(p))
          || (!wasTrashed && !nowTrashed && pNormalUpdateOk(p));
    }

    match /users/{uid} {
      // Read your own profile always; read others only once you're approved.
      allow get: if signedIn() && (request.auth.uid == uid || isApproved());
      allow list: if isApproved();

      // On registration you may create ONLY your own doc, and only as a
      // pending member — you cannot make yourself an admin or pre-approved,
      // nor grant yourself the QA / captions roles. Privileges are admin-only.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'pending'
        && request.resource.data.get('qa', false) == false
        && request.resource.data.get('captions', false) == false
        && request.resource.data.get('lead', false) == false
        && request.resource.data.get('academyEditor', false) == false;

      // A QA reviewer is a distinct, non-production department: they must never
      // carry production skills (that's what makes them staffable/recommended).
      // Enforce the invariant server-side so no client — even a buggy admin
      // form — can persist a QA user with skills.
      function qaInvariantOk(d) {
        return d.get('qa', false) == false || d.get('skills', []).size() == 0;
      }
      // Admins edit profiles (approvals, roles, skills, flags, removal), subject
      // to the QA invariant. Members may self-edit ONLY their notification
      // preferences and appearance — nothing else (changing their own
      // skills/flags could game auto-assignment).
      allow update: if (isAdmin() && qaInvariantOk(request.resource.data))
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifPrefs', 'appearance']));
      allow delete: if isAdmin();

      // Web-push device tokens: a user manages only their own.
      match /fcmTokens/{token} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // In-app notifications. Written server-side (Admin SDK bypasses rules);
    // a user may read only their own and mark them read — nothing else.
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // Materialized reminder queue — entirely server-owned. Admins may read it
    // for the delivery log; no client ever writes it.
    match /reminderInstances/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Durable per-user-per-day reminder email digest — server-owned. Admins read
    // it for the delivery log; no client ever writes it.
    match /reminderDigests/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin operations saga state (e.g. user removal) — server-owned. Admins read
    // for progress/status; no client ever writes it.
    match /adminOps/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Immutable administrative audit log — server-authored only. Admins read it;
    // NO client may ever create, edit, or delete an audit event (not even admins).
    match /auditEvents/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Email delivery ledger (Resend) — written server-side only; admins read
    // it for the delivery log. Never client-writable.
    match /emailDeliveries/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Email usage counters (monthly/daily quota). Server-managed; admins read
    // for the usage dashboard. Never client-writable — the hard limit can't be
    // altered from the frontend.
    match /systemUsage/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Sanitized real-time email-usage snapshot for the admin panel — server-authored
    // (in the same transaction as the internal cache). Admins READ it for the live
    // dashboard; NO client may create, update, or delete it. The server Admin SDK
    // bypasses rules, so its writes still succeed.
    match /adminDiagnostics/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin-managed recurring event series: everyone approved can read the
    // active series (Home renders occurrences); only admins create/edit.
    match /eventSeries/{id} {
      allow read: if isApproved();
      // Admins create + edit series (archive/unarchive is an `archived` flag update).
      // HARD DELETE IS DENIED for every client: a recurring series is retired by
      // ARCHIVING it (reversible), never erased — so linked history/occurrences and
      // the restore path are never lost to a stray client delete.
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // App-wide settings (e.g. default reminder schedule, leadership roles).
    match /settings/{docId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    match /tasks/{taskId} {
      // READ-ACCESS POLICY — Option A: Trash is NOT confidential.
      // This is a shared internal board: every approved member already reads every
      // task, and a trashed task is the same content that was visible moments ago —
      // there is no data-sensitivity reason to hide it at the data layer. So members
      // retain read access to trashed tasks; the app hides Trash OPERATIONALLY (the
      // shared activeTasks boundary + a non-admin "unavailable" dead-end). That
      // dead-end is a UX affordance, NOT a security boundary — it is deliberately not
      // described to users as "unauthorized". Admin-only confidentiality (Option B)
      // would need an explicit queryable `trashed` field + a migration of every
      // existing task; it is intentionally NOT adopted here.
      allow read: if isApproved();

      // Admins create tasks. A task can never be BORN trashed — client-supplied
      // Trash metadata is rejected at creation. Nor can it be BORN (or imported)
      // directly into a link-gated stage (In Review / Approved / Ready to Post /
      // Posted) without the type's valid required links — same invariant as updates.
      allow create: if isAdmin()
        && request.resource.data.get('deletedAt', null) == null
        && !('deletedBy' in request.resource.data)
        && !('deletedByName' in request.resource.data)
        && (!pStatusRequiresLinks(request.resource.data.get('status', 'Planned'))
            || pRequiredLinksPresent());
      // HARD DELETE IS DENIED for everyone, including admins. Removal is a reversible
      // soft-delete (the Trash transition below); permanent deletion is out of scope
      // and has no client path — so a stale/compromised client can never erase content.
      allow delete: if false;

      // Updates are decided by taskUpdateDecision(), structured around mutually-
      // exclusive Trash-state transitions (active->trashed, trashed->active,
      // active->active); trashed->trashed has no matching branch and is denied. The
      // caller's profile is resolved ONCE here and threaded in, so the whole decision
      // stays well under the evaluator's expression budget — no assertFails can pass
      // by exhaustion instead of by an explicit false policy result.
      allow update: if signedIn() && hasProfile() && taskUpdateDecision(myDoc());

      // Comments as a subcollection (v1.1) — the canonical comment store. Approved
      // members read all and may post their OWN (uid must match the caller;
      // display name is trusted only for rendering). Strict schema + size limits;
      // edits/removal are admin-only. Feeds the server-side @mention trigger.
      match /comments/{commentId} {
        // The parent task must EXIST and be ACTIVE for any comment WRITE. While a task
        // is in Trash (or missing), ALL comment collaboration stops — creation AND
        // admin moderation (edit/delete) — so Trash freezes the whole thread;
        // moderation resumes on Restore. Reads are unaffected. The exists() guard
        // means a missing parent returns an ordinary `false`, never a `null.data`
        // evaluation error.
        function parentTaskActive() {
          return exists(/databases/$(database)/documents/tasks/$(taskId))
            && get(/databases/$(database)/documents/tasks/$(taskId)).data.get('deletedAt', null) == null;
        }
        allow read: if isApproved();
        allow create: if isApproved()
          && parentTaskActive()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'who', 'txt', 'tm', 'mentions', 'mentionNames', 'mentionAll', 'mentionRanges'])
          && request.resource.data.txt is string
          && request.resource.data.txt.size() > 0
          && request.resource.data.txt.size() <= 2000
          && request.resource.data.tm == request.time
          // Individual mentions: uids the trigger re-validates + notifies (≤ 20).
          && request.resource.data.get('mentions', []) is list
          && request.resource.data.get('mentions', []).size() <= 20
          // mentionNames: the exact selected display strings (render + rename-resilience),
          // aligned to `mentions`. Client-only rendering aid — the server never trusts it
          // for identity — so it is bounded but not otherwise constrained.
          && request.resource.data.get('mentionNames', []) is list
          && request.resource.data.get('mentionNames', []).size() <= 20
          // mentionRanges: flat [start,end,…] token positions in `txt` — RENDERING ONLY
          // (so a mention still highlights after its trailing space is deleted). Never an
          // identity source; the trigger notifies from `mentions`/`mentionAll` alone. ≤ 42
          // (21 tokens × 2) keeps it bounded.
          && request.resource.data.get('mentionRanges', []) is list
          && request.resource.data.get('mentionRanges', []).size() <= 42
          // mentionAll: the @all group token. The TRIGGER derives recipients from the
          // task's assigneeUids — a client-supplied uid list is never expanded.
          && request.resource.data.get('mentionAll', false) is bool;
        allow update, delete: if isAdmin() && parentTaskActive();
      }
    }

    // Issue log: user-filed reports/feature-requests and auto-captured runtime
    // errors. Strict schema (no arbitrary fields), size-bounded, server-stamped,
    // and only under your own uid. Auto-captured ERRORS may come from any signed-in
    // user (they happen during setup, before approval); user-INITIATED reports and
    // feature requests require an approved account.
    match /issues/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'uid', 'kind', 'message', 'stack', 'action', 'code', 'taskId', 'note',
             'status', 'route', 'online', 'userAgent', 'viewport', 'url', 'email',
             'title', 'problem', 'beneficiary', 'link', 'createdAt'])
        && request.resource.data.kind in ['error', 'report', 'feature_request']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('message', '').size() <= 4000
        && request.resource.data.get('stack', '').size() <= 8000
        && request.resource.data.get('note', '').size() <= 4000
        && request.resource.data.get('problem', '').size() <= 4000
        && (request.resource.data.kind == 'error' || isApproved());
      // Only admins can read the log, triage (resolve), or delete.
      allow read, update, delete: if isAdmin();
    }

    // =====================================================================
    // IFC Creative Academy (Learn). See docs/academy.md for the data model.
    //
    //   courses/{cid}                     course (status: draft|published|archived)
    //   courses/{cid}/lessons/{lid}       learner-readable lesson (questions, NO answers)
    //   courses/{cid}/lessons/{lid}/comments/{id}   lesson discussion
    //   courses/{cid}/quizKeys/{lid}      correct answers + explanations — EDITORS ONLY
    //   academySettings/{id}              purpose video etc. — admin-managed
    //   learnerProgress/{uid}/courseProgress/{cid}   learner-writable progress, EXCEPT
    //                                     `earned` (server-only, via submitQuizAttempt)
    //   quizAttempts/{uid}/attempts/{id}  server-written attempts; learner reads own
    //
    // Roles: editor = admin OR the course's instructorUid; leader = admin OR
    // lead == true (may read any learner's progress/attempts). Drafts are
    // invisible to everyone but editors — the status gate is applied on every
    // read of a course and its subcollections.
    // =====================================================================
    function isLeader() {
      return isApproved() && (myDoc().role == 'admin' || myDoc().get('lead', false) == true);
    }
    function courseDoc(cid) { return get(/databases/$(database)/documents/courses/$(cid)).data; }
    function courseExists(cid) { return exists(/databases/$(database)/documents/courses/$(cid)); }
    // v4: a GLOBAL Academy-editor role (admin, or academyEditor == true on the
    // profile). Per-course instructor ownership is gone; `c` is unused but kept
    // so every call site reads the same.
    function isAcademyEditor() {
      return isApproved() && (myDoc().role == 'admin' || myDoc().get('academyEditor', false) == true);
    }
    function isCourseEditorOf(c) { return isAcademyEditor(); }
    // Hidden categories: a denormalised id list maintained with the category doc
    // (one extra get per request; cached by the rules engine within a request).
    function hiddenCategoryIds() {
      return exists(/databases/$(database)/documents/academySettings/categoryIndex)
        ? get(/databases/$(database)/documents/academySettings/categoryIndex).data.get('hidden', [])
        : [];
    }
    function isCourseEditor(cid) { return courseExists(cid) && isCourseEditorOf(courseDoc(cid)); }
    function canSeeCourseDoc(c) {
      return isApproved() && (isAcademyEditor()
        || (c.get('status', '') == 'published' && !(c.get('category', '') in hiddenCategoryIds())));
    }
    function canSeeCourse(cid) { return courseExists(cid) && canSeeCourseDoc(courseDoc(cid)); }
    function guideDoc(gid) { return get(/databases/$(database)/documents/guides/$(gid)).data; }
    function guideExists(gid) { return exists(/databases/$(database)/documents/guides/$(gid)); }
    function isGuideEditor(gid) { return guideExists(gid) && isCourseEditorOf(guideDoc(gid)); }
    function canSeeGuide(gid) { return guideExists(gid) && canSeeCourseDoc(guideDoc(gid)); }
    function pathDoc(pid) { return get(/databases/$(database)/documents/paths/$(pid)).data; }
    function pathExists(pid) { return exists(/databases/$(database)/documents/paths/$(pid)); }
    // Paths aren't filed under a category, so they're gated on status alone (the
    // content they reference is still gated by its own rules).
    function canSeePathDoc(p) {
      return isApproved() && (isAcademyEditor() || p.get('status', '') == 'published');
    }
    function canSeePath(pid) { return pathExists(pid) && canSeePathDoc(pathDoc(pid)); }

    // The six categories (src/academyProgress.js ACADEMY_CATEGORIES) + the two
    // legacy ids still readable until the one-off migration (docs/academy.md).
    // v4: categories are records — any existing academyCategories/{id} is valid,
    // plus the two legacy ids still readable until the one-off migration.
    // v6.10: a category being deleted is LOCKED (server-written `deleting`):
    // nothing new can be filed under it — no course/draft/guide/path create,
    // move in, publish or autosave that names it — so its contents can only
    // shrink until the server deletes the record.
    function categoryLocked(c) {
      return exists(/databases/$(database)/documents/academyCategories/$(c))
        && get(/databases/$(database)/documents/academyCategories/$(c)).data.get('deleting', null) != null;
    }
    function validCategory(c) {
      return c is string && c.size() <= 40 && c.matches('[a-z0-9-]+')
        && (exists(/databases/$(database)/documents/academyCategories/$(c)) || c in ['videography', 'social-media'])
        && !categoryLocked(c);
    }
    function validTopics(t) { return t is list && t.size() <= 12; }
    function validTopicIds(t) { return t is list && t.size() <= 12; }
    function validImageRef(r) {
      return r == null || (r is map
        && r.keys().hasOnly(['path', 'version', 'contentType', 'bytes', 'w', 'h'])
        && r.path is string && r.path.size() <= 300 && r.path.matches('academy/.*'));
    }
    function validVideoRef(v) {
      return v == null || (v is map
        && v.keys().hasOnly(['provider', 'id', 'hash'])
        && v.provider in ['youtube', 'vimeo', 'gdrive']
        && v.id is string && v.id.size() >= 1 && v.id.size() <= 100);
    }
    // Markdown format version of the doc's formatted text (absent = 1, legacy).
    function validMdVersion(d) { return d.get('mdVersion', 1) in [1, 2]; }
    function validCourse(d) {
      return d.keys().hasOnly([
           'title', 'category', 'level', 'status', 'instructorUid', 'instructorName', 'topics', 'topicIds',
           'about', 'outcomes', 'requirements', 'durationMinutes', 'cover', 'previewVideo', 'modules',
           'lessonCount', 'requiredLessonCount', 'requiredQuizLessonIds', 'bonusLessonIds', 'prerequisiteMap', 'priorKnowledge',
           'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'publishedAt', 'archivedAt', 'mdVersion'])
        && validMdVersion(d)
        && d.get('prerequisiteMap', {}) is map && d.get('prerequisiteMap', {}).size() <= 300
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
        && d.status in ['draft', 'published', 'archived']
        && validCategory(d.category)
        && d.level in ['beginner', 'intermediate', 'advanced']
        && d.get('instructorUid', '') is string && d.get('instructorUid', '').size() <= 128
        && d.get('instructorName', '') is string && d.get('instructorName', '').size() <= 120
        && validTopics(d.get('topics', [])) && validTopicIds(d.get('topicIds', []))
        && d.get('about', '') is string && d.get('about', '').size() <= 20000
        && d.get('outcomes', []) is list && d.get('outcomes', []).size() <= 20
        && d.get('requirements', []) is list && d.get('requirements', []).size() <= 20
        && d.get('modules', []) is list && d.get('modules', []).size() <= 50
        && validImageRef(d.get('cover', null))
        && validVideoRef(d.get('previewVideo', null))
        && d.updatedAt == request.time;
    }
    // Provider metadata captured at save time (title/creator/thumbnail from the
    // official oEmbed endpoint via the fetchVideoMetadata callable). Display only.
    function validVideoMeta(m) {
      return m == null || (m is map
        && m.keys().hasOnly(['title', 'author', 'authorUrl', 'thumbnailUrl', 'sourceUrl', 'fetchedAt', 'durationSec', 'isLive', 'id'])
        && (m.get('durationSec', null) == null || (m.durationSec is number && m.durationSec > 0 && m.durationSec < 100000))
        && m.get('isLive', false) is bool
        && m.get('title', '') is string && m.get('title', '').size() <= 200
        && m.get('author', '') is string && m.get('author', '').size() <= 120
        && m.get('authorUrl', '') is string && m.get('authorUrl', '').size() <= 300
        && m.get('thumbnailUrl', '') is string && m.get('thumbnailUrl', '').size() <= 500
        && (m.get('thumbnailUrl', '') == '' || m.get('thumbnailUrl', '').matches('https://.*'))
        && m.get('sourceUrl', '') is string && m.get('sourceUrl', '').size() <= 300);
    }
    // v6.5 prerequisites: a list of other lesson ids in the same course — at most
    // 20, no duplicates, never the lesson itself. The full graph (cycles, missing
    // lessons, optional lessons that required ones depend on) can't be checked in
    // rules; checkCoursePrerequisites (callable) checks the DRAFT and records the
    // verdict per draft revision. A published lesson that carries prerequisites
    // is only accepted when that verdict is ok for the revision being published.
    function validPrereqShape(d, lid) {
      return !d.keys().hasAny(['prerequisites'])
        || (d.prerequisites is list && d.prerequisites.size() <= 20
            && d.prerequisites.toSet().size() == d.prerequisites.size()
            && !(lid in d.prerequisites));
    }
    function checkPath(cid) { return /databases/$(database)/documents/courseDraftChecks/$(cid); }
    // The server's verdict exists, is ok, and is for the draft revision being
    // published (any later draft edit bumps rev, so a stale verdict fails).
    function verdictCurrent(cid) {
      return exists(checkPath(cid)) && exists(draftPath(cid))
        && get(checkPath(cid)).data.ok == true
        && get(checkPath(cid)).data.rev == get(draftPath(cid)).data.rev;
    }
    // A lesson's prerequisites must be EXACTLY what the verdict approved for it.
    function prereqsVerified(d, cid, lid) {
      return d.get('prerequisites', []).size() == 0
        || (verdictCurrent(cid) && d.prerequisites == get(checkPath(cid)).data.prerequisiteMap.get(lid, []));
    }
    // A course carrying prerequisites must have the module order + map the
    // verdict approved (order decides which prerequisites are "earlier").
    function coursePrereqsVerified(d, cid) {
      return d.get('prerequisiteMap', {}).size() == 0
        || (verdictCurrent(cid)
            && d.get('modules', []) == get(checkPath(cid)).data.modules
            && d.prerequisiteMap == get(checkPath(cid)).data.prerequisiteMap);
    }
    // v6.8: every published LESSON is exactly what the server's publish check
    // approved for this draft revision — its kind, video record and quiz mode +
    // questions (so a modified browser can't publish a video lesson without a
    // valid link, or a quiz whose answers don't fit its questions). The record
    // lives in the editor-only verdict doc, never on a learner-readable doc.
    function checkedLesson(cid, lid) { return get(checkPath(cid)).data.get('lessonChecks', {}).get(lid, null); }
    function lessonVerified(d, cid, lid) {
      return verdictCurrent(cid) && checkedLesson(cid, lid) != null
        && d.get('kind', 'video') == checkedLesson(cid, lid).kind
        && d.get('video', null) == checkedLesson(cid, lid).video
        && d.get('quiz', {}).get('mode', 'none') == checkedLesson(cid, lid).mode
        && d.get('quiz', {}).get('questions', []) == checkedLesson(cid, lid).questions;
    }
    // …and every published answer key is the one the check approved.
    function keyVerified(d, cid, lid) {
      return verdictCurrent(cid)
        && get(checkPath(cid)).data.get('answerKeys', {}).get(lid, null) != null
        && d.get('answers', {}) == get(checkPath(cid)).data.answerKeys[lid];
    }
    // A course becomes / stays published only with a passing check for the
    // revision being published. Exempt: changes that don't publish anything
    // (moving it to another category when a category is deleted).
    function publishVerified(cid, after, before) {
      return after.status != 'published'
        || (before != null && before.status == 'published' && after.diff(before).affectedKeys().hasOnly(['category', 'updatedAt', 'updatedBy']))
        || verdictCurrent(cid);
    }
    // v6.9: deleting PUBLISHED lessons / answer keys is part of Publish (the
    // course doc is rewritten in the same write) or of an admin's permanent
    // course delete. A non-admin can't strip a course's lessons on their own.
    function courseRewrittenNow(cid) {
      return existsAfter(/databases/$(database)/documents/courses/$(cid))
        && getAfter(/databases/$(database)/documents/courses/$(cid)).data.updatedAt == request.time;
    }
    // Recommended prior knowledge: advisory course references (never a gate).
    function validPriorKnowledge(d, cid) {
      return !d.keys().hasAny(['priorKnowledge'])
        || (d.priorKnowledge is map && d.priorKnowledge.keys().hasOnly(['courseIds', 'note'])
            && d.priorKnowledge.get('courseIds', []) is list && d.priorKnowledge.get('courseIds', []).size() <= 10
            && d.priorKnowledge.get('courseIds', []).toSet().size() == d.priorKnowledge.get('courseIds', []).size()
            && !(cid in d.priorKnowledge.get('courseIds', []))
            && d.priorKnowledge.get('note', '') is string && d.priorKnowledge.get('note', '').size() <= 300);
    }
    function validLesson(d) {
      return d.keys().hasOnly([
           'title', 'moduleId', 'kind', 'video', 'videoMeta', 'thumbMode', 'description', 'resources', 'thumb', 'bonus',
           'durationMinutes', 'quiz', 'prerequisites', 'createdAt', 'createdAtMs', 'updatedAt', 'mdVersion'])
        && validMdVersion(d)
        && d.get('thumbMode', 'source') in ['source', 'custom']
        && validVideoMeta(d.get('videoMeta', null))
        && d.title is string && d.title.size() <= 120
        && d.get('kind', 'video') in ['video', 'written', 'exercise', 'resource']
        && d.get('moduleId', '') is string
        && d.get('description', '') is string && d.get('description', '').size() <= 20000
        && d.get('resources', []) is list && d.get('resources', []).size() <= 20
        && d.get('bonus', false) is bool
        && validVideoRef(d.get('video', null))
        && validImageRef(d.get('thumb', null))
        // Learner-readable quiz: mode + questions only. The `answers` key is NOT
        // allowed here — correct answers live in quizKeys (editor-only).
        && (!d.keys().hasAny(['quiz']) || (d.quiz is map
             && d.quiz.keys().hasOnly(['mode', 'passMark', 'retryLimit', 'questions'])
             && d.quiz.mode in ['none', 'practice', 'required']
             && d.quiz.get('questions', []) is list && d.quiz.get('questions', []).size() <= 30))
        && d.updatedAt == request.time;
    }

    // Before deleting an uploaded image, the client checks no OTHER course
    // still uses it (live or draft lessons, by thumb.path) — a collection-group
    // query. Editors can already read every lesson doc individually (live via
    // canSeeCourse, drafts via isAcademyEditor), so this grants nothing new.
    match /{path=**}/lessons/{lid} {
      allow read: if isAcademyEditor();
    }

    match /courses/{cid} {
      // get + list: published to approved members; drafts/archived to editors.
      allow read: if canSeeCourseDoc(resource.data);
      // Academy editors create courses; new courses start as drafts so nothing
      // is ever visible before an editor publishes it.
      // v6: Publish creates the live doc from a draft, so it may be born
      // 'published'; it can never be born 'archived'.
      allow create: if isAcademyEditor() && validCourse(request.resource.data)
        && validPriorKnowledge(request.resource.data, cid) && coursePrereqsVerified(request.resource.data, cid)
        && publishVerified(cid, request.resource.data, null)
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      // Editors edit + publish/unpublish/archive. An instructor can't hand the
      // course to someone else or rewrite its creation stamp.
      allow update: if isCourseEditorOf(resource.data) && validCourse(request.resource.data)
        && validPriorKnowledge(request.resource.data, cid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['modules', 'prerequisiteMap'])
            || coursePrereqsVerified(request.resource.data, cid))
        && publishVerified(cid, request.resource.data, resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      // Permanent delete: admin only, never while published (unpublish first) —
      // except inside an admin's reviewed category deletion (its category is
      // locked for deletion), where the published course is deleted directly.
      allow delete: if isAdmin() && (resource.data.status != 'published' || categoryLocked(resource.data.category));

      match /lessons/{lid} {
        allow read: if canSeeCourse(cid);
        // v6: writes check the editor role directly — a first Publish creates
        // the course doc and its lessons in ONE transaction, and exists() sees
        // the pre-transaction state. (Reads stay gated by canSeeCourse.)
        allow create: if isAcademyEditor() && validLesson(request.resource.data)
          && validPrereqShape(request.resource.data, lid) && prereqsVerified(request.resource.data, cid, lid)
          && lessonVerified(request.resource.data, cid, lid);
        // unchanged prerequisites need no new verdict (the course doc's rule
        // covers a changed lesson ORDER)
        allow update: if isAcademyEditor() && validLesson(request.resource.data)
          && validPrereqShape(request.resource.data, lid)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['prerequisites'])
              || prereqsVerified(request.resource.data, cid, lid))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['kind', 'video', 'quiz'])
              || lessonVerified(request.resource.data, cid, lid));
        allow delete: if isAdmin() || (isAcademyEditor() && courseRewrittenNow(cid));

        // Discussion: comments + threaded replies (parentId). `role` is stamped
        // by the client but VERIFIED here against the real role, so a learner
        // can't badge themselves as the instructor.
        match /comments/{id} {
          function commentRole() {
            return myDoc().role == 'admin' ? 'admin' : (isAcademyEditor() ? 'moderator' : 'learner');
          }
          allow read: if canSeeCourse(cid);
          allow create: if canSeeCourse(cid)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'txt', 'parentId', 'pinned', 'createdAt', 'editedAt'])
            && request.resource.data.name is string && request.resource.data.name.size() <= 120
            && request.resource.data.txt is string
            && request.resource.data.txt.size() >= 1 && request.resource.data.txt.size() <= 2000
            && request.resource.data.role == commentRole()
            && (request.resource.data.parentId == null || request.resource.data.parentId is string)
            && request.resource.data.pinned == false
            && request.resource.data.createdAt == request.time;
          // Author: edit own text. Editors: edit text (moderation) + pin/unpin.
          // Pinning alone changes ONLY `pinned` — it must not stamp editedAt, or
          // the comment would wrongly show as "edited".
          allow update: if canSeeCourse(cid) && (
            (request.resource.data.txt is string
              && request.resource.data.txt.size() >= 1 && request.resource.data.txt.size() <= 2000
              && request.resource.data.editedAt == request.time
              && ((resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['txt', 'editedAt']))
               || (isCourseEditor(cid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['txt', 'editedAt', 'pinned']))))
            || (isCourseEditor(cid)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
                && request.resource.data.pinned is bool));
          allow delete: if canSeeCourse(cid)
            && (resource.data.uid == request.auth.uid || isCourseEditor(cid));
        }
      }

      // Correct answers + explanations. Never readable by learners; graded by
      // the submitQuizAttempt callable with the Admin SDK.
      match /quizKeys/{lid} {
        allow read: if isCourseEditor(cid);
        allow create, update: if isAcademyEditor()
          && request.resource.data.keys().hasOnly(['answers', 'explanations', 'updatedAt'])
          && request.resource.data.get('answers', {}) is map
          && request.resource.data.get('explanations', {}) is map
          && keyVerified(request.resource.data, cid, lid);
        allow delete: if isAdmin() || (isAcademyEditor() && courseRewrittenNow(cid));
      }
    }

    // ---- Course DRAFTS (v6): the private working copy authors edit. Learners
    // never read these; Publish copies a draft to courses/{cid} (+ lessons,
    // quizKeys) with the same lesson ids. `rev` must go up by exactly one on
    // every write, so a stale editor's write is rejected (concurrent edits are
    // detected, never silently overwritten). Draft lessons may only change in
    // the same batch/transaction as that rev bump.
    function draftPath(cid) { return /databases/$(database)/documents/courseDrafts/$(cid); }
    function validCourseDraft(d) {
      return d.keys().hasOnly([
           'title', 'category', 'level', 'about', 'outcomes', 'requirements', 'cover', 'previewVideo',
           'topicIds', 'topics', 'modules', 'priorKnowledge', 'rev', 'publishedRev', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'mdVersion'])
        && validMdVersion(d)
        && d.get('title', '') is string && d.get('title', '').size() <= 120
        && (d.get('category', '') == '' || validCategory(d.category))
        && d.get('level', 'beginner') in ['beginner', 'intermediate', 'advanced']
        && d.get('about', '') is string && d.get('about', '').size() <= 20000
        && d.get('outcomes', []) is list && d.get('outcomes', []).size() <= 20
        && d.get('requirements', []) is list && d.get('requirements', []).size() <= 20
        && d.get('modules', []) is list && d.get('modules', []).size() <= 50
        && validImageRef(d.get('cover', null))
        && validVideoRef(d.get('previewVideo', null))
        && validTopics(d.get('topics', [])) && validTopicIds(d.get('topicIds', []))
        && d.rev is int && d.publishedRev is int && d.publishedRev <= d.rev
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    function draftRevBumped(cid) {
      return exists(draftPath(cid))
        ? getAfter(draftPath(cid)).data.rev == get(draftPath(cid)).data.rev + 1
        : getAfter(draftPath(cid)).data.rev == 1;
    }
    // Server verdict on a draft's prerequisite graph (checkCoursePrerequisites).
    // v6.11 — a resource's private working copy (Academy editors only). Every
    // save bumps rev by exactly one (stale editors get a conflict). Never filed
    // under a category that's being deleted (validCategory).
    function validGuideDraft(d) {
      return d.keys().hasOnly(['title', 'category', 'topics', 'topicIds', 'video', 'videoMeta', 'thumbMode', 'body', 'resources', 'thumb',
             'durationMinutes', 'mdVersion', 'rev', 'publishedRev', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.get('title', '') is string && d.get('title', '').size() <= 120
        && (d.get('category', '') == '' || validCategory(d.category))
        && validTopics(d.get('topics', [])) && validTopicIds(d.get('topicIds', []))
        && d.get('thumbMode', 'source') in ['source', 'custom']
        && validVideoMeta(d.get('videoMeta', null)) && validVideoRef(d.get('video', null)) && validImageRef(d.get('thumb', null))
        && d.get('body', '') is string && d.get('body', '').size() <= 20000
        && d.get('resources', []) is list && d.get('resources', []).size() <= 20
        && validMdVersion(d)
        && d.rev is int && d.publishedRev is int && d.publishedRev <= d.rev
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    match /guideDrafts/{gid} {
      allow read: if isAcademyEditor();
      allow create: if isAcademyEditor() && validGuideDraft(request.resource.data) && request.resource.data.rev == 1
        && request.resource.data.publishedRev == 0
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAcademyEditor() && validGuideDraft(request.resource.data)
        && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy;
      // discard unpublished changes (the published version stays) / delete a never-published resource
      allow delete: if isAcademyEditor();
    }
    match /courseDraftChecks/{cid} {
      allow read: if isAcademyEditor();
      allow write: if false;
    }
    match /courseDrafts/{cid} {
      allow read: if isAcademyEditor();
      allow create: if isAcademyEditor() && validCourseDraft(request.resource.data) && validPriorKnowledge(request.resource.data, cid)
        && request.resource.data.rev == 1 && request.resource.data.publishedRev in [0, 1]
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAcademyEditor() && validCourseDraft(request.resource.data) && validPriorKnowledge(request.resource.data, cid)
        && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      // Admins delete any draft (permanent course delete); editors may discard a
      // draft only while the course has never been published.
      allow delete: if isAdmin() || (isAcademyEditor() && resource.data.publishedRev == 0 && !courseExists(cid));

      match /lessons/{lid} {
        function validDraftLesson(d) {
          return d.keys().hasOnly([
               'title', 'moduleId', 'kind', 'video', 'videoMeta', 'thumbMode', 'description', 'resources', 'thumb', 'bonus',
               'durationMinutes', 'quiz', 'quizKey', 'prerequisites', 'createdAtMs', 'updatedAt', 'mdVersion'])
            && validMdVersion(d)
            && d.get('title', '') is string && d.get('title', '').size() <= 120
            && d.get('kind', 'video') in ['video', 'written', 'exercise', 'resource']
            && d.get('description', '') is string && d.get('description', '').size() <= 20000
            && d.get('resources', []) is list && d.get('resources', []).size() <= 20
            && d.get('bonus', false) is bool
            && d.get('thumbMode', 'source') in ['source', 'custom']
            && validVideoRef(d.get('video', null))
            && validVideoMeta(d.get('videoMeta', null))
            && validImageRef(d.get('thumb', null))
            && d.get('quizKey', {}) is map
            && d.updatedAt == request.time;
        }
        allow read: if isAcademyEditor();
        allow create, update: if isAcademyEditor() && validDraftLesson(request.resource.data) && validPrereqShape(request.resource.data, lid) && draftRevBumped(cid);
        allow delete: if isAcademyEditor() && (draftRevBumped(cid) || !existsAfter(draftPath(cid)));
      }
    }

    // ---- Category + topic RECORDS (v4). Stable ids (slug at creation), names
    // editable, admin-managed. Learners read them all (hidden ones are filtered
    // client-side and their COURSES are gated by hiddenCategoryIds()).
    function validCategoryRecord(d) {
      return d.keys().hasOnly(['name', 'short', 'description', 'order', 'hidden', 'cover', 'courseOrder', 'guideOrder', 'deleting', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.get('guideOrder', []) is list && d.get('guideOrder', []).size() <= 500
        && d.get('courseOrder', []) is list && d.get('courseOrder', []).size() <= 500
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.get('short', '') is string && d.get('short', '').size() <= 30
        && d.get('description', '') is string && d.get('description', '').size() <= 300
        && d.get('order', 0) is number
        && d.get('hidden', false) is bool
        && validImageRef(d.get('cover', null))
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    match /academyCategories/{id} {
      allow read: if isApproved();
      allow create: if isAdmin() && id.matches('[a-z0-9-]{1,40}') && validCategoryRecord(request.resource.data)
        && request.resource.data.createdAt == request.time;
      // `deleting` (the deletion lock + reviewed plan) is server-written only.
      allow update: if isAdmin() && validCategoryRecord(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deleting']);
      // v6.10: deleted only by the server (finalizeCategoryDeletion), after it has
      // confirmed no course, draft, guide or path is still filed under it.
      allow delete: if false;
    }
    function validTopicRecord(d) {
      return d.keys().hasOnly(['name', 'description', 'hidden', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.get('description', '') is string && d.get('description', '').size() <= 300
        && d.get('hidden', false) is bool
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    match /academyTopics/{id} {
      allow read: if isApproved();
      allow create: if isAcademyEditor() && id.matches('[a-z0-9-]{1,40}') && validTopicRecord(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }
    // The denormalised hidden-category list the course rules consult.
    match /academySettings/categoryIndex {
      allow read: if isApproved();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['hidden', 'updatedAt', 'updatedBy'])
        && request.resource.data.get('hidden', []) is list
        && request.resource.data.updatedAt == request.time;
    }

    // Learn-home settings. Admin-managed, approved members read.
    //   purposeVideo — the "Start here" introduction
    //   categories   — artwork per FIXED category id (names/ids live in code and
    //                  cannot be renamed or removed from here: only `art` is stored)
    // Every stored artwork entry must be a valid image reference (no loops in
    // rules, so each fixed id is checked explicitly).
    function validArt(a) {
      return (!a.keys().hasAny(['heart-of-serving']) || validImageRef(a['heart-of-serving']))
        && (!a.keys().hasAny(['photography']) || validImageRef(a['photography']))
        && (!a.keys().hasAny(['filmmaking']) || validImageRef(a['filmmaking']))
        && (!a.keys().hasAny(['graphic-design']) || validImageRef(a['graphic-design']))
        && (!a.keys().hasAny(['social-media-storytelling']) || validImageRef(a['social-media-storytelling']))
        && (!a.keys().hasAny(['creating-together']) || validImageRef(a['creating-together']));
    }
    match /academySettings/categories {
      allow read: if isApproved();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['art', 'updatedAt', 'updatedBy'])
        && request.resource.data.get('art', {}) is map
        && request.resource.data.get('art', {}).keys().hasOnly(['heart-of-serving', 'photography', 'filmmaking', 'graphic-design', 'social-media-storytelling', 'creating-together'])
        && validArt(request.resource.data.get('art', {}))
        && request.resource.data.updatedAt == request.time;
    }
    // Unfinished course-deletion cleanup (see src/academyDeletion.js) — admins only.
    match /academySettings/pendingCleanup {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['courses', 'updatedAt', 'updatedBy'])
        && request.resource.data.get('courses', {}) is map
        && request.resource.data.updatedAt == request.time;
    }
    match /academySettings/{id} {
      allow read: if isApproved() && id != 'pendingCleanup';
      allow write: if isAdmin() && id != 'categories' && id != 'categoryIndex' && id != 'pendingCleanup'
        // the Learn introduction video: thumbMode + videoMeta (provider thumbnail) as on lessons
        && request.resource.data.keys().hasOnly(['title', 'intro', 'video', 'thumb', 'thumbMode', 'videoMeta', 'updatedAt', 'updatedBy'])
        && request.resource.data.get('title', '') is string && request.resource.data.get('title', '').size() <= 120
        && request.resource.data.get('intro', '') is string && request.resource.data.get('intro', '').size() <= 4000
        && validVideoRef(request.resource.data.get('video', null))
        && validImageRef(request.resource.data.get('thumb', null))
        && request.resource.data.get('thumbMode', 'source') in ['source', 'custom']
        && validVideoMeta(request.resource.data.get('videoMeta', null))
        && request.resource.data.updatedAt == request.time;
    }

    // Learner progress. The learner owns the doc; `earned` is SERVER-ONLY: a
    // client write may neither add it on create nor change it on update, so a
    // passed-quiz completion can only come from submitQuizAttempt.
    // v6.4: completion is SERVER-ONLY. `lessons` (completion flags; older docs
    // also hold view/position data there), `earned` (passed required quizzes) and
    // `finishedAt`/`finishedRequired` (Finish course) are written only by the
    // completeLesson / submitQuizAttempt / finishCourse callables, which enforce
    // the course order. The learner writes view/position data to `playback` and
    // the last-viewed bookkeeping fields.
    function validProgress(d, uid, cid) {
      return d.keys().hasOnly(['uid', 'courseId', 'startedAt', 'lastLessonId', 'lastViewedAt', 'updatedAt',
                               'lessons', 'earned', 'playback', 'finishedAt', 'finishedRequired', 'finishedVia',
                               'progressModel', 'attemptGrants', 'attemptRequests'])
        && d.uid == uid && d.courseId == cid
        && d.get('lessons', {}) is map
        && d.get('playback', {}) is map
        && d.get('lastLessonId', '') is string
        && d.updatedAt == request.time;
    }
    match /learnerProgress/{uid}/courseProgress/{cid} {
      allow read: if signedIn() && (request.auth.uid == uid || isLeader());
      allow create: if signedIn() && request.auth.uid == uid && canSeeCourse(cid)
        && validProgress(request.resource.data, uid, cid)
        && !request.resource.data.keys().hasAny(['lessons', 'earned', 'finishedAt', 'finishedRequired', 'finishedVia', 'progressModel', 'attemptGrants', 'attemptRequests']);
      allow update: if signedIn() && request.auth.uid == uid && isApproved()
        && validProgress(request.resource.data, uid, cid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lessons', 'earned', 'finishedAt', 'finishedRequired', 'finishedVia', 'progressModel', 'attemptGrants', 'attemptRequests']);
      // Cleanup after a PERMANENT course delete only: the course doc must be gone.
      allow delete: if isAdmin() && !courseExists(cid);
    }
    // Leaders' per-course view uses a collection-group query over courseProgress.
    match /{path=**}/courseProgress/{cid} {
      allow read: if isLeader();
    }

    // Quiz attempts: server-written only. Learners read their own; leaders any.
    match /quizAttempts/{uid}/attempts/{id} {
      allow read: if signedIn() && (request.auth.uid == uid || isLeader());
      allow create, update: if false;
      allow delete: if isAdmin() && !courseExists(resource.data.courseId);
    }
    match /{path=**}/attempts/{id} {
      allow read: if isLeader();
    }

    // ---- Quick guides: standalone help (video link + body, or text only) ----
    function validGuide(d) {
      return d.keys().hasOnly([
           'title', 'category', 'topics', 'topicIds', 'status', 'instructorUid', 'instructorName',
           'video', 'videoMeta', 'thumbMode', 'body', 'resources', 'thumb', 'durationMinutes', 'mdVersion',
           'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'publishedAt', 'archivedAt'])
        && validMdVersion(d)
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
        && d.status in ['draft', 'published', 'archived']
        && validCategory(d.category)
        && validTopics(d.get('topics', [])) && validTopicIds(d.get('topicIds', []))
        && d.get('instructorUid', '') is string && d.get('instructorUid', '').size() <= 128
        && d.get('thumbMode', 'source') in ['source', 'custom']
        && validVideoMeta(d.get('videoMeta', null))
        && d.get('body', '') is string && d.get('body', '').size() <= 20000
        && d.get('resources', []) is list && d.get('resources', []).size() <= 20
        && validVideoRef(d.get('video', null))
        && validImageRef(d.get('thumb', null))
        && d.updatedAt == request.time;
    }
    // v6.11 — Tips & resources have private drafts (guideDrafts/{gid}). Learners
    // read guides/{gid}; its content changes only by PUBLISHING the draft: the
    // published fields must equal the draft being published, in the same write
    // that bumps the draft revision (publishedRev = rev). A published video link
    // must be a supported format; there must be a video or some text.
    function guideDraftPath(gid) { return /databases/$(database)/documents/guideDrafts/$(gid); }
    function strictVideo(v) {
      return v == null
        || (v.provider == 'youtube' && v.id.matches('[A-Za-z0-9_-]{11}') && !v.keys().hasAny(['hash']))
        || (v.provider == 'vimeo' && v.id.matches('[0-9]{6,12}') && (!v.keys().hasAny(['hash']) || v.hash.matches('[a-fA-F0-9]{6,16}')))
        || (v.provider == 'gdrive' && v.id.matches('[A-Za-z0-9_-]{20,80}') && !v.keys().hasAny(['hash']));
    }
    // ONE draft read and ONE map diff over the content fields. (Comparing each
    // field with its own get() — 12 reads + nested map/list equality for
    // videoMeta, thumb and resources — exceeded the rules' 1000-expression budget
    // for a real video resource, so first publishes were refused.) A field present
    // on one side only counts as a difference: the client copies exactly the
    // draft's fields and deletes the rest.
    function guideContentKeys() {
      return ['title', 'category', 'topics', 'topicIds', 'video', 'videoMeta', 'thumbMode', 'body', 'resources', 'thumb', 'durationMinutes', 'mdVersion'];
    }
    function guidePublishesDraft(d, gid) {
      return exists(guideDraftPath(gid)) && guidePublishesExistingDraft(d, gid);
    }
    function guidePublishesExistingDraft(d, gid) {
      let before = get(guideDraftPath(gid)).data;
      let after = getAfter(guideDraftPath(gid)).data;
      return after.rev == before.rev + 1 && after.publishedRev == after.rev
        && !before.diff(d).affectedKeys().hasAny(guideContentKeys())
        && strictVideo(d.get('video', null))
        && (d.get('video', null) != null || d.get('body', '').size() > 0);
    }
    // changes that don't publish content: status (unpublish/archive/restore) and
    // category moves (deleting a category) — exempt; anything else published needs the draft
    function guideContentUnchanged(after, before) {
      return after.diff(before).affectedKeys().hasOnly(['status', 'category', 'updatedAt', 'updatedBy', 'publishedAt', 'archivedAt']);
    }
    match /guides/{gid} {
      allow read: if canSeeCourseDoc(resource.data);
      allow create: if isAcademyEditor() && validGuide(request.resource.data)
        && (request.resource.data.status == 'draft' || (request.resource.data.status == 'published' && guidePublishesDraft(request.resource.data, gid)))
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isCourseEditorOf(resource.data) && validGuide(request.resource.data)
        && (request.resource.data.status != 'published'
            || (resource.data.status == 'published' && guideContentUnchanged(request.resource.data, resource.data))
            || guidePublishesDraft(request.resource.data, gid))
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      // admins; never while published — except inside a reviewed category deletion
      allow delete: if isAdmin() && (resource.data.status != 'published' || categoryLocked(resource.data.category));

      // Guide discussion — same shape + permissions as lesson comments.
      match /comments/{id} {
        function guideCommentRole() {
          return myDoc().role == 'admin' ? 'admin' : (isAcademyEditor() ? 'moderator' : 'learner');
        }
        allow read: if canSeeGuide(gid);
        allow create: if canSeeGuide(gid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'txt', 'parentId', 'pinned', 'createdAt', 'editedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 120
          && request.resource.data.txt is string
          && request.resource.data.txt.size() >= 1 && request.resource.data.txt.size() <= 2000
          && request.resource.data.role == guideCommentRole()
          && (request.resource.data.parentId == null || request.resource.data.parentId is string)
          && request.resource.data.pinned == false
          && request.resource.data.createdAt == request.time;
        allow update: if canSeeGuide(gid) && (
          (request.resource.data.txt is string
            && request.resource.data.txt.size() >= 1 && request.resource.data.txt.size() <= 2000
            && request.resource.data.editedAt == request.time
            && ((resource.data.uid == request.auth.uid
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['txt', 'editedAt']))
             || (isGuideEditor(gid)
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['txt', 'editedAt', 'pinned']))))
          || (isGuideEditor(gid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
              && request.resource.data.pinned is bool));
        allow delete: if canSeeGuide(gid)
          && (resource.data.uid == request.auth.uid || isGuideEditor(gid));
      }
    }

    // ---- Learning paths: ordered REFERENCES to courses / lessons / guides ----
    // Items carry only ids + a label; the learner's access to each referenced
    // item is still decided by that item's own rules (a path never grants access).
    function validPath(d) {
      return d.keys().hasOnly([
           'title', 'purpose', 'category', 'topics', 'topicIds', 'status', 'instructorUid', 'instructorName',
           'cover', 'items', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'publishedAt', 'archivedAt'])
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
        && d.status in ['draft', 'published', 'archived']
        && (d.get('category', '') == '' || validCategory(d.category))
        && validTopics(d.get('topics', [])) && validTopicIds(d.get('topicIds', []))
        && d.get('instructorUid', '') is string && d.get('instructorUid', '').size() <= 128
        && d.get('purpose', '') is string && d.get('purpose', '').size() <= 4000
        && validImageRef(d.get('cover', null))
        && d.get('items', []) is list && d.get('items', []).size() <= 60
        && d.updatedAt == request.time;
    }
    match /paths/{pid} {
      allow read: if canSeePathDoc(resource.data);
      allow create: if isAcademyEditor() && validPath(request.resource.data)
        && request.resource.data.status == 'draft'
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isCourseEditorOf(resource.data) && validPath(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin() && resource.data.status != 'published';
    }

    // ---- "Start here" introduction: the learner's own watched/dismissed flag.
    match /learnerProgress/{uid}/intro/{id} {
      allow read: if signedIn() && (request.auth.uid == uid || isLeader());
      allow create, update: if signedIn() && request.auth.uid == uid && isApproved()
        && request.resource.data.keys().hasOnly(['uid', 'watched', 'watchedAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.watched is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ---- Guide "reviewed" flag: the learner's own self-report (not an assessment).
    match /learnerProgress/{uid}/guideReviews/{gid} {
      allow read: if signedIn() && (request.auth.uid == uid || isLeader());
      allow create, update: if signedIn() && request.auth.uid == uid && canSeeGuide(gid)
        && request.resource.data.keys().hasOnly(['uid', 'guideId', 'reviewed', 'reviewedAt', 'updatedAt'])
        && request.resource.data.uid == uid && request.resource.data.guideId == gid
        && request.resource.data.reviewed is bool
        && request.resource.data.updatedAt == request.time;
      // only an admin, and only once the resource itself was deleted (clean-up)
      allow delete: if isAdmin() && !exists(/databases/$(database)/documents/guides/$(gid));
    }
    match /{path=**}/guideReviews/{gid} {
      allow read: if isLeader();
    }

    // ---- Path bookkeeping (started / last item). Completion is DERIVED from the
    // referenced content's progress, so nothing here can mark anything complete.
    match /learnerProgress/{uid}/pathProgress/{pid} {
      allow read: if signedIn() && (request.auth.uid == uid || isLeader());
      allow create, update: if signedIn() && request.auth.uid == uid && canSeePath(pid)
        && request.resource.data.keys().hasOnly(['uid', 'pathId', 'startedAt', 'lastItemKey', 'lastViewedAt', 'completedAt', 'updatedAt'])
        && request.resource.data.uid == uid && request.resource.data.pathId == pid
        && request.resource.data.get('lastItemKey', '') is string
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /{path=**}/pathProgress/{pid} {
      allow read: if isLeader();
    }
  }
}
