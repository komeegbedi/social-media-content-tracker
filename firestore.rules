rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function myDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    // A removed/disabled account is denied everywhere — even if it still carries
    // an 'admin' role on its tombstone. `disabled` is the authoritative kill switch.
    function notDisabled() {
      return myDoc().get('disabled', false) != true;
    }
    function isAdmin() {
      return hasProfile() && myDoc().role == 'admin' && notDisabled();
    }
    function isApproved() {
      return hasProfile() && notDisabled() && (myDoc().status == 'approved' || myDoc().role == 'admin');
    }
    function isQA() {
      return hasProfile() && (myDoc().qa == true || myDoc().role == 'admin');
    }

    // ---- task workflow (the 7-stage state machine, mirrored from src/data.js) ----
    function taskStatuses() {
      return ['Planned', 'In Progress', 'In Review', 'Changes Requested',
              'Approved', 'Ready to Post', 'Posted'];
    }
    // Is a proposed `from -> to` status change legal for THIS actor?
    //   owner/admin   : Planned→In Progress, In Progress→In Review, Changes Requested→In Review
    //   QA/admin      : In Review→Approved | Changes Requested   (the QA decision)
    //   captions/admin: Approved→Ready to Post, Ready to Post→Posted
    //   admin         : any valid status (manual correction)
    // A no-op (from == to) is always allowed so members can edit other fields.
    function transitionAllowed(from, to) {
      let isOwner = resource.data.owner == myDoc().name;
      let isCap = myDoc().get('captions', false) == true;
      return from == to
        || isAdmin()
        || (isOwner && (
              (from == 'Planned' && to == 'In Progress') ||
              (from == 'In Progress' && to == 'In Review') ||
              (from == 'Changes Requested' && to == 'In Review')))
        || (isQA() && from == 'In Review' && (to == 'Approved' || to == 'Changes Requested'))
        || (isCap && (
              (from == 'Approved' && to == 'Ready to Post') ||
              (from == 'Ready to Post' && to == 'Posted')));
    }
    // Integrity checks applied to EVERY task write (members AND admins):
    //  • status is a real status value;
    //  • the audit log is append-only — it can only grow, by at most one entry
    //    per write (no truncation, no wholesale forgery of history);
    //  • archivedAt only appears on a Posted task, and a non-admin can never
    //    clear one that's already set (no un-archiving to hide history).
    function taskIntegrityOk() {
      let oldAct = resource.data.get('activity', []);
      let newAct = request.resource.data.get('activity', []);
      let oldArch = resource.data.get('archivedAt', null);
      let newArch = request.resource.data.get('archivedAt', null);
      return request.resource.data.status in taskStatuses()
        && newAct is list
        && newAct.size() >= oldAct.size()
        && newAct.size() <= oldAct.size() + 1
        && (newArch == null || request.resource.data.status == 'Posted')
        && (isAdmin() || oldArch == null || newArch != null);
    }

    match /users/{uid} {
      // Read your own profile always; read others only once you're approved.
      allow get: if signedIn() && (request.auth.uid == uid || isApproved());
      allow list: if isApproved();

      // On registration you may create ONLY your own doc, and only as a
      // pending member — you cannot make yourself an admin or pre-approved,
      // nor grant yourself the QA / captions roles. Privileges are admin-only.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'pending'
        && request.resource.data.get('qa', false) == false
        && request.resource.data.get('captions', false) == false
        && request.resource.data.get('lead', false) == false;

      // A QA reviewer is a distinct, non-production department: they must never
      // carry production skills (that's what makes them staffable/recommended).
      // Enforce the invariant server-side so no client — even a buggy admin
      // form — can persist a QA user with skills.
      function qaInvariantOk(d) {
        return d.get('qa', false) == false || d.get('skills', []).size() == 0;
      }
      // Admins edit profiles (approvals, roles, skills, flags, removal), subject
      // to the QA invariant. Members may self-edit ONLY their notification
      // preferences and appearance — nothing else (changing their own
      // skills/flags could game auto-assignment).
      allow update: if (isAdmin() && qaInvariantOk(request.resource.data))
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifPrefs', 'appearance']));
      allow delete: if isAdmin();

      // Web-push device tokens: a user manages only their own.
      match /fcmTokens/{token} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // In-app notifications. Written server-side (Admin SDK bypasses rules);
    // a user may read only their own and mark them read — nothing else.
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // Materialized reminder queue — entirely server-owned. Admins may read it
    // for the delivery log; no client ever writes it.
    match /reminderInstances/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Durable per-user-per-day reminder email digest — server-owned. Admins read
    // it for the delivery log; no client ever writes it.
    match /reminderDigests/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin operations saga state (e.g. user removal) — server-owned. Admins read
    // for progress/status; no client ever writes it.
    match /adminOps/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Immutable administrative audit log — server-authored only. Admins read it;
    // NO client may ever create, edit, or delete an audit event (not even admins).
    match /auditEvents/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Email delivery ledger (Resend) — written server-side only; admins read
    // it for the delivery log. Never client-writable.
    match /emailDeliveries/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Email usage counters (monthly/daily quota). Server-managed; admins read
    // for the usage dashboard. Never client-writable — the hard limit can't be
    // altered from the frontend.
    match /systemUsage/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin-managed recurring event series: everyone approved can read the
    // active series (Home renders occurrences); only admins create/edit.
    match /eventSeries/{id} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    // App-wide settings (e.g. default reminder schedule, leadership roles).
    match /settings/{docId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isApproved();

      // Only admins create or delete tasks.
      allow create, delete: if isAdmin();

      // Every write must pass base integrity (valid status, append-only audit
      // log, archivedAt semantics). On top of that:
      //  • admins may change anything else;
      //  • approved members may touch only collaboration fields, and any status
      //    change must be a role-legal transition (owner/QA/captions matrix).
      allow update: if taskIntegrityOk() && (
        isAdmin()
        || (isApproved()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'comments', 'reactions', 'updatedAt', 'archivedAt',
                           'blockedOn', 'links', 'activity', 'caption', 'postLink'])
            && transitionAllowed(resource.data.status, request.resource.data.status)));

      // Comments as a subcollection (v1.1) — the canonical comment store. Approved
      // members read all and may post their OWN (uid must match the caller;
      // display name is trusted only for rendering). Strict schema + size limits;
      // edits/removal are admin-only. Feeds the server-side @mention trigger.
      match /comments/{commentId} {
        allow read: if isApproved();
        allow create: if isApproved()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'who', 'txt', 'tm', 'mentions'])
          && request.resource.data.txt is string
          && request.resource.data.txt.size() > 0
          && request.resource.data.txt.size() <= 2000
          && request.resource.data.tm == request.time
          && request.resource.data.get('mentions', []) is list
          && request.resource.data.get('mentions', []).size() <= 20;
        allow update, delete: if isAdmin();
      }
    }

    // Issue log: user-filed reports/feature-requests and auto-captured runtime
    // errors. Strict schema (no arbitrary fields), size-bounded, server-stamped,
    // and only under your own uid. Auto-captured ERRORS may come from any signed-in
    // user (they happen during setup, before approval); user-INITIATED reports and
    // feature requests require an approved account.
    match /issues/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'uid', 'kind', 'message', 'stack', 'action', 'code', 'taskId', 'note',
             'status', 'route', 'online', 'userAgent', 'viewport', 'url', 'email',
             'title', 'problem', 'beneficiary', 'link', 'createdAt'])
        && request.resource.data.kind in ['error', 'report', 'feature_request']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('message', '').size() <= 4000
        && request.resource.data.get('stack', '').size() <= 8000
        && request.resource.data.get('note', '').size() <= 4000
        && request.resource.data.get('problem', '').size() <= 4000
        && (request.resource.data.kind == 'error' || isApproved());
      // Only admins can read the log, triage (resolve), or delete.
      allow read, update, delete: if isAdmin();
    }
  }
}
