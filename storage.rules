rules_version = '2';

// IFC Creative Academy — Cloud Storage rules (Academy images ONLY).
//
// Everything else in the bucket is denied. Images are read through the SDK
// (getBlob) by signed-in, approved members — there are no public objects and
// the app never hands out download URLs, so access always follows the same
// model as the Firestore course / resource docs:
//   • published images in a visible category: any approved member
//   • draft / archived / hidden-category images: Academy editors only
//   • uploads / replacements: Academy editors, against the item's draft;
//     deletes: Academy editors — the client stores a versioned path and only
//     deletes the previous object AFTER the new reference is saved.
// Content type and size are enforced here as well as in the client: the client
// re-encodes to JPEG ≤ ~250 KB, so the 2 MB ceiling is a hard backstop, not the
// expected size. Firestore lookups are cross-service rules (firestore.get).
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function me() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }
    function notDisabled() { return me().get('disabled', false) != true; }
    function isAdmin() { return hasProfile() && me().role == 'admin' && notDisabled(); }
    function isApproved() {
      return hasProfile() && notDisabled() && (me().status == 'approved' || me().role == 'admin');
    }
    // ---------------------------------------------------------------------
    // DOCUMENT BUDGET: a Storage rules evaluation may access at most TWO
    // Firestore documents ("No more than two Firestore documents may be accessed
    // in a single Rules evaluation" — Storage rules docs, "Enhance with Cloud
    // Firestore"). The emulator does NOT enforce this, so every allow below is
    // written to need at most users/{uid} + ONE other document, and
    // src/storageRulesBudget.test.js fails if any request could touch more.
    // (The previous rules needed users + courses + courseDrafts for a draft-only
    // course, which production refused as storage/unauthorized.)
    // ---------------------------------------------------------------------
    // v4: global Academy-editor role (admin, or academyEditor on the profile).
    function isEditor() {
      return isApproved() && (isAdmin() || me().get('academyEditor', false) == true);
    }
    // Learner image access for a course or resource: ONE server-maintained
    // marker for "published AND its category isn't hidden" — the test
    // firestore.rules applies to the item (functions/academyLearnerMedia.js).
    // It is EVENTUALLY consistent: a missing marker hides images (granting is
    // fail-closed), but after unpublishing / hiding an existing marker keeps
    // allowing approved learners' reads until its trigger has run (no
    // documented bound; failures retried, drift found by
    // scripts/reconcile-learner-media.mjs).
    function learnerMedia(key) {
      return firestore.exists(/databases/(default)/documents/academyLearnerMedia/$(key));
    }
    // Editors see every course and resource (as in firestore.rules); approved
    // learners see the images of published items in visible categories.
    function canSeeCourseImages(courseId) {
      return isEditor() || (isApproved() && learnerMedia('course_' + courseId));
    }
    function canSeeGuideImages(guideId) {
      return isEditor() || (isApproved() && learnerMedia('guide_' + guideId));
    }
    // Uploads are made from the editor's private DRAFT, which the workspace
    // creates (and the server confirms) before any upload — for a never-published
    // course and when editing a published one. So the draft is the one record
    // an upload is checked against: users + courseDrafts (or guideDrafts).
    function draftExists(courseId) {
      return firestore.exists(/databases/(default)/documents/courseDrafts/$(courseId));
    }
    function guideDraftExists(guideId) {
      return firestore.exists(/databases/(default)/documents/guideDrafts/$(guideId));
    }
    // Deleting course / resource images (replaced images, cancelled uploads,
    // clean-up after a delete): Academy editors. The previous rule
    // (editor of an existing course OR leftover of a deleted one) already
    // reduced to exactly this; the client still keeps any image another
    // course, draft, resource, path or category uses.

    // Learning paths (users + paths: within the budget, unchanged).
    function pathDoc(pathId) {
      return firestore.get(/databases/(default)/documents/paths/$(pathId)).data;
    }
    function pathExists(pathId) {
      return firestore.exists(/databases/(default)/documents/paths/$(pathId));
    }
    function isPathEditor(pathId) { return isEditor() && pathExists(pathId); }
    function canSeePath(pathId) {
      return isApproved() && pathExists(pathId)
        && (isEditor() || pathDoc(pathId).status == 'published');
    }
    function validImage() {
      return request.resource != null
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024;
    }

    // Course covers: academy/covers/{courseId}/{version}.jpg
    match /academy/covers/{courseId}/{file} {
      allow read: if canSeeCourseImages(courseId);                              // users + marker
      allow create, update: if isEditor() && draftExists(courseId) && validImage(); // users + courseDrafts
      allow delete: if isEditor();                                              // users
    }

    // Lesson thumbnails: academy/lessonThumbs/{courseId}/{lessonId}/{version}.jpg
    match /academy/lessonThumbs/{courseId}/{lessonId}/{file} {
      allow read: if canSeeCourseImages(courseId);
      allow create, update: if isEditor() && draftExists(courseId) && validImage();
      allow delete: if isEditor();
    }

    // Quick-guide thumbnails: academy/guideThumbs/{guideId}/{version}.jpg
    match /academy/guideThumbs/{guideId}/{file} {
      allow read: if canSeeGuideImages(guideId);                                    // users + marker
      allow create, update: if isEditor() && guideDraftExists(guideId) && validImage(); // users + guideDrafts
      allow delete: if isEditor();                                                  // users
    }

    // Learning-path covers: academy/pathCovers/{pathId}/{version}.jpg
    match /academy/pathCovers/{pathId}/{file} {
      allow read: if canSeePath(pathId);                                        // users + paths
      allow create, update: if isPathEditor(pathId) && validImage();
      allow delete: if isPathEditor(pathId);
    }

    // Category covers (v4, portrait 3:4): academy/catCovers/{categoryId}/{version}.jpg
    // — any category RECORD id. Older landscape uploads under categoryArt/ stay
    // readable until an admin replaces them.
    match /academy/catCovers/{categoryId}/{file} {
      allow read: if isApproved();
      allow create, update: if isAdmin() && validImage()
        && firestore.exists(/databases/(default)/documents/academyCategories/$(categoryId));
      allow delete: if isAdmin();
    }
    match /academy/categoryArt/{categoryId}/{file} {
      allow read: if isApproved();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // Purpose-video thumbnail (Learn home): admins manage, approved members view.
    match /academy/purpose/{file} {
      allow read: if isApproved();
      allow create, update: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    // Default deny for every other path.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
