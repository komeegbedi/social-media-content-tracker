# Production builds MUST target real Firebase, never the local emulator.
# Overrides VITE_USE_EMULATOR from .env (which developers set to true for local dev).
VITE_USE_EMULATOR=false

# Production Firebase project and Cloud Storage bucket. Verified 2026-11-16 with
# `gcloud storage buckets list --project=ifc-social-media-tracker`: the bucket is in
# US-EAST1 and linked to Firebase. Not secret (both ship in the web bundle); set here
# so a production build can't pick up a developer's local values from .env.
VITE_FIREBASE_PROJECT_ID=ifc-social-media-tracker
VITE_FIREBASE_STORAGE_BUCKET=ifc-social-media-tracker.firebasestorage.app
